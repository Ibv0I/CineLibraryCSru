<Window
    x:Class="CineМедиатекаCS.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CineМедиатекаCS"
    xmlns:models="using:CineМедиатекаCS.Models"
    xmlns:views="using:CineМедиатекаCS.Views"
    Название="CineМедиатека">

    <!-- Transparent root reveals the window's Mica backdrop. The content
         frame stays opaque (crisp pages); only the title bar and the floating
         sidebar card let Mica through. -->
    <Grid x:Name="RootGrid" Назадground="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Solid opaque window fill, shown only when Mica is turned OFF in
             Настройки. Theme-bound so it's always the right base colour. -->
        <Rectangle x:Name="MicaВыкл.Назадdrop" Grid.Row="0" Grid.RowSpan="2"
                   Fill="{ThemeResource BgBrush}" Visibility="Collapsed"/>

        <!-- ═══ CUSTOM TITLEBAR (drag region) ═══ -->
        <Grid x:Name="AppНазваниеBar" Grid.Row="0" Назадground="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center" Margin="8,0,0,0">
                <!-- v2.5.1 — reopen-sidebar toggle lives here so it never
                     overlaps the page title when the sidebar is collapsed. -->
                <Button x:Name="SidebarReopenBtn" Click="Вкл.ToggleSidebar"
                        Visibility="Collapsed"
                        Назадground="Transparent" BorderThickness="0"
                        Foreground="{ThemeResource MutedBrush}"
                        Padding="6,4" CornerRadius="6"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Показать боковую панель"
                        ToolTipService.ToolTip="Показать боковую панель">
                    <FontIcon Glyph="&#xE89F;" FontSize="14"
                              FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                </Button>
                <Image Source="ms-appx:///Assets/icon.ico"
                       Width="16" Height="16" VerticalAlignment="Center"/>
                <TextBlock Text="CineМедиатека" FontSize="12" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Global search, centered in the title bar (interactive children
                 of the title-bar element receive input automatically). Диски
                 the Медиатека page's search engine. -->
            <Grid Grid.Column="1" x:Name="НазваниеПоискHost"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Width="520" Margin="0,0,130,0" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="НазваниеScopeCombo" Grid.Column="0"
                          SelectionChanged="Вкл.НазваниеScopeChanged"
                          SelectedIndex="0"
                          Height="32" MinWidth="84" VerticalAlignment="Center"
                          CornerRadius="8"
                          Назадground="{ThemeResource InputBgBrush}"
                          Foreground="{ThemeResource TextBrush}"
                          BorderBrush="{ThemeResource InputBorderBrush}"
                          ToolTipService.ToolTip="Результаты поиска">
                    <ComboBoxItem Tag="all"   Content="Все"/>
                    <ComboBoxItem Tag="title" Content="Название"/>
                    <ComboBoxItem Tag="cast"  Content="Актёры и съёмочная группа"/>
                </ComboBox>
                <AutoSuggestBox x:Name="НазваниеПоискBox" Grid.Column="1"
                                PlaceholderText="Поиск названия, актёра, режиссёра…"
                                QueryIcon="Find"
                                Height="32" VerticalAlignment="Center"
                                CornerRadius="8"
                                TextChanged="Вкл.НазваниеПоискChanged"
                                Назадground="{ThemeResource InputBgBrush}"
                                BorderBrush="{ThemeResource InputBorderBrush}"
                                Foreground="{ThemeResource TextBrush}"/>
            </Grid>

        </Grid>

        <!-- ═══ MAIN CONTENT ROW ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarCol" Width="248"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ SIDEBAR ═══ -->
            <!-- v2.9.3 — the sidebar is a floating rounded card: it sits
                 inset from the window edges (margin) on its own rounded
                 surface, like the Claude desktop app. The gap reveals the
                 window background behind it. Nothing inside the pane
                 changed — only this wrapper + the column width (bumped to
                 keep the inner content the same 240 px as before). -->
            <Border x:Name="SidebarCard" Grid.Column="0"
                    Margin="8,4,4,8" CornerRadius="12"
                    Назадground="{ThemeResource SidebarBrush}"
                    BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1"
                    Translation="0,0,24">
                <Border.Shadow>
                    <ThemeShadow/>
                </Border.Shadow>
            <Grid x:Name="SidebarGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo — v2.9 wordmark with a gold ▶ accent inside a
                     purple tile. The tile uses a deep violet gradient + a
                     faint top-edge highlight so it reads as a crisp, lifted
                     badge instead of the flat pale lavender it was before.
                     Click opens the About dialog. -->
                <Button Grid.Row="0" Click="Вкл.AboutClick"
                        Назадground="Transparent" BorderThickness="0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,12,14,8">
                    <StackPanel x:Name="LogoPanel" Orientation="Horizontal" Spacing="10">
                        <Border CornerRadius="9" Width="32" Height="32"
                                BorderBrush="#55FFFFFF" BorderThickness="1">
                            <Border.Назадground>
                                <!-- Vivid violet gradient: bright purple top,
                                     deep indigo-violet base — echoes the app
                                     icon's rich purple body. -->
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                                    <GradientStop Выкл.set="0" Color="#C13AEB"/>
                                    <GradientStop Выкл.set="1" Color="#5B21B6"/>
                                </LinearGradientBrush>
                            </Border.Назадground>
                            <!-- Child is clipped to the parent's corner radius. -->
                            <Grid>
                                <!-- Glossy top sheen — soft white highlight over
                                     the upper half, fading to nothing. -->
                                <Border>
                                    <Border.Назадground>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Выкл.set="0"    Color="#4DFFFFFF"/>
                                            <GradientStop Выкл.set="0.55" Color="#00FFFFFF"/>
                                        </LinearGradientBrush>
                                    </Border.Назадground>
                                </Border>
                                <!-- Tiny sparkle, top-left, nodding to the icon. -->
                                <TextBlock Text="✦" FontSize="7" Foreground="#CCFFFFFF"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                           Margin="5,4,0,0"/>
                                <!-- Glossy white play triangle (vector, crisp). -->
                                <Polygon Points="0,0 0,13 11,6.5"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Margin="2,0,0,0">
                                    <Polygon.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Выкл.set="0" Color="#FFFFFF"/>
                                            <GradientStop Выкл.set="1" Color="#E9D5FF"/>
                                        </LinearGradientBrush>
                                    </Polygon.Fill>
                                </Polygon>
                            </Grid>
                        </Border>
                        <StackPanel x:Name="LogoTextPanel" VerticalAlignment="Center"
                                    Orientation="Horizontal" Spacing="0">
                            <TextBlock Text="Cine" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextBrush}"/>
                            <TextBlock Text="Медиатека" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrandPurpleBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- Nav -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NavPanel" Padding="8,0">

                        <!-- МЕДИАТЕКА group (v1.9.3) -->
                        <TextBlock Text="МЕДИАТЕКА" Style="{StaticResource SidebarGroupLabelStyle}"/>

                        <!-- Все фильмы -->
                        <Button x:Name="BtnВсеФильмы" Style="{StaticResource NavItemStyle}"
                                Click="Вкл.NavВсеФильмы">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Foreground="{ThemeResource NavМедиатекаIconBrush}" Glyph="&#xE786;" FontSize="15"
                                              FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="Все фильмы" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource BadgeStyle}">
                                    <TextBlock x:Name="TotalBadge" Text="0" FontSize="11"
                                               Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Все сериалы (v2.8) -->
                        <Button x:Name="BtnTvShows" Style="{StaticResource NavItemStyle}" Click="Вкл.NavTvShows">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Foreground="{ThemeResource NavМедиатекаIconBrush}" Glyph="&#xE7F4;" FontSize="15"
                                              FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="Все сериалы" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource BadgeStyle}">
                                    <TextBlock x:Name="TvShowsBadge" Text="0" FontSize="11"
                                               Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Избранное -->
                        <Button x:Name="BtnИзбранное" Style="{StaticResource NavItemStyle}" Click="Вкл.NavИзбранное">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Foreground="{ThemeResource NavМедиатекаIconBrush}" Glyph="&#xE734;" FontSize="15"
                                          FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="Избранное" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Список просмотра (v1.3) -->
                        <Button x:Name="BtnСписок просмотра" Style="{StaticResource NavItemStyle}" Click="Вкл.NavСписок просмотра">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Foreground="{ThemeResource NavМедиатекаIconBrush}" Glyph="&#xE74C;" FontSize="15"
                                              FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="К просмотру" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource BadgeStyle}">
                                    <TextBlock x:Name="Список просмотраBadge" Text="0" FontSize="11"
                                               Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Заметки (v2.8.2) — every movie that carries a note -->
                        <Button x:Name="BtnЗаметки" Style="{StaticResource NavItemStyle}" Click="Вкл.NavЗаметки">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Foreground="{ThemeResource NavМедиатекаIconBrush}" Glyph="&#xE70B;" FontSize="15"
                                              FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="Заметки" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource BadgeStyle}">
                                    <TextBlock x:Name="ЗаметкиBadge" Text="0" FontSize="11"
                                               Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Просмотрено и удалено (v3.3) — records of watched-then-deleted movies.
                             Hidden until the first record exists. -->
                        <Button x:Name="BtnПросмотреноGone" Style="{StaticResource NavItemStyle}"
                                Click="Вкл.NavПросмотреноGone" Visibility="Collapsed">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Foreground="{ThemeResource NavМедиатекаIconBrush}" Glyph="&#xE7B8;" FontSize="15"
                                              FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="Просмотрено и удалено" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource BadgeStyle}">
                                    <TextBlock x:Name="ПросмотреноGoneBadge" Text="0" FontSize="11"
                                               Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- ОБЗОР group (v1.9.3) -->
                        <TextBlock Text="ОБЗОР" Style="{StaticResource SidebarGroupLabelStyle}"/>

                        <!-- Продолжить просмотр (v1.8) -->
                        <Button x:Name="BtnContinueWatching" Style="{StaticResource NavItemStyle}"
                                Click="Вкл.NavContinueWatching">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Foreground="{ThemeResource NavDiscoverIconBrush}" Glyph="&#xE768;" FontSize="15"
                                              FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="Продолжить просмотр" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource BadgeStyle}">
                                    <TextBlock x:Name="ContinueWatchingBadge" Text="0" FontSize="11"
                                               Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Недавно добавленные (v1.7) -->
                        <Button x:Name="BtnRecentlyДобавитьed" Style="{StaticResource NavItemStyle}" Click="Вкл.NavRecentlyДобавитьed">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Foreground="{ThemeResource NavDiscoverIconBrush}" Glyph="&#xE823;" FontSize="15"
                                          FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="Недавно добавленные" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Недавно просмотренные (v2.9) -->
                        <Button x:Name="BtnRecentlyПросмотрено" Style="{StaticResource NavItemStyle}"
                                Click="Вкл.NavRecentlyПросмотрено">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Foreground="{ThemeResource NavDiscoverIconBrush}" Glyph="&#xE823;" FontSize="15"
                                              FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="Недавно просмотренные" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource BadgeStyle}">
                                    <TextBlock x:Name="RecentlyПросмотреноBadge" Text="0" FontSize="11"
                                               Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Random Pick (v1.7) -->
                        <Button x:Name="BtnRandomPick" Style="{StaticResource NavItemStyle}" Click="Вкл.NavRandomPick">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Foreground="{ThemeResource NavDiscoverIconBrush}" Glyph="&#xE8B1;" FontSize="15"
                                          FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="Удиви меня" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- В этот день (v2.9) — hidden when nothing today.
                             Click opens a dialog with the matches: movies you
                             watched on this date in past years, and films
                             released on this date in past years. -->
                        <Button x:Name="BtnВкл.ThisDay" Style="{StaticResource NavItemStyle}"
                                Click="Вкл.NavВкл.ThisDay" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Foreground="{ThemeResource NavDiscoverIconBrush}" Glyph="&#xE787;" FontSize="15"
                                          FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="В этот день" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- ОБЗОР group (v2.1) — banner-style category pages -->
                        <TextBlock Text="ОБЗОР" Style="{StaticResource SidebarGroupLabelStyle}"/>

                        <Button x:Name="BtnОбзорGenre" Style="{StaticResource NavItemStyle}"
                                Click="Вкл.NavОбзорGenre">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Foreground="{ThemeResource NavОбзорIconBrush}" Glyph="&#xE8EC;" FontSize="15"
                                          FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="По жанру" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnОбзорDecade" Style="{StaticResource NavItemStyle}"
                                Click="Вкл.NavОбзорDecade">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Foreground="{ThemeResource NavОбзорIconBrush}" Glyph="&#xE787;" FontSize="15"
                                          FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="По десятилетию" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnОбзорРейтинг" Style="{StaticResource NavItemStyle}"
                                Click="Вкл.NavОбзорРейтинг">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Foreground="{ThemeResource NavОбзорIconBrush}" Glyph="&#xE735;" FontSize="15"
                                          FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="По рейтингу" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnКоллекции" Style="{StaticResource NavItemStyle}"
                                Click="Вкл.NavКоллекции">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Foreground="{ThemeResource NavОбзорIconBrush}" Glyph="&#xE8B7;" FontSize="15"
                                          FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="Коллекции" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- ИНСТРУМЕНТЫ group (v1.9.3) -->
                        <TextBlock Text="ИНСТРУМЕНТЫ" Style="{StaticResource SidebarGroupLabelStyle}"/>

                        <!-- Статистика (v1.4.1) -->
                        <Button x:Name="BtnСтатистика" Style="{StaticResource NavItemStyle}" Click="Вкл.NavСтатистика">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Foreground="{ThemeResource NavToolsIconBrush}" Glyph="&#xE9D9;" FontSize="15"
                                          FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="Статистика" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Дубликаты (v3.4.4) — find movies held more than once -->
                        <Button x:Name="BtnДубликаты" Style="{StaticResource NavItemStyle}" Click="Вкл.NavДубликаты">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Foreground="{ThemeResource NavToolsIconBrush}" Glyph="&#xE8C8;" FontSize="15"
                                          FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="Дубликаты" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>


                        <!-- v2.9 — Резервная копия / restore personal state.
                             Opens a small dialog with Экспорт / Import. -->
                        <Button x:Name="BtnРезервная копия" Style="{StaticResource NavItemStyle}"
                                Click="Вкл.NavРезервная копия">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Foreground="{ThemeResource NavToolsIconBrush}" Glyph="&#xE74E;" FontSize="15"
                                          FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="Резервная копия" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- v3.9.0 — Экспорт (was a button on Все фильмы): the whole
                             library, or what Все фильмы shows, as CSV or HTML. -->
                        <Button x:Name="BtnЭкспорт" Style="{StaticResource NavItemStyle}"
                                Click="Вкл.NavЭкспорт">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Foreground="{ThemeResource NavToolsIconBrush}" Glyph="&#xEDE1;" FontSize="15"
                                          FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="Экспорт" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- My Lists section (v1.9.2) — user-defined custom lists.
                             v2.5.1: header restyled as a quiet group label
                             matching МЕДИАТЕКА / ОБЗОР / ОБЗОР / ИНСТРУМЕНТЫ. -->
                        <StackPanel x:Name="UserListsHeader" Margin="0,8,0,0">
                            <Grid Margin="8,4,4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Tag="UserLists" Click="Вкл.SidebarSectionToggle"
                                        Style="{StaticResource SidebarSectionHeaderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="МОИ СПИСКИ" CharacterSpacing="150"/>
                                        <TextBlock x:Name="UserListsChevron" Grid.Column="1"
                                                   Text="⌃" FontSize="11" Margin="6,0,0,0"/>
                                    </Grid>
                                </Button>
                                <Button Grid.Column="1" Click="Вкл.НовыйUserList"
                                        Назадground="Transparent" BorderThickness="0"
                                        Padding="6,0" Margin="2,0,0,0"
                                        VerticalAlignment="Stretch"
                                        ToolTipService.ToolTip="Создать новый список">
                                    <TextBlock Text="+" FontSize="14" FontWeight="Bold"
                                               Foreground="{ThemeResource MutedBrush}"
                                               VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                            <StackPanel x:Name="UserListsItemsPanel"/>
                        </StackPanel>

                        <!-- v2.9 — Tags section. Collapsible like My Lists.
                             Populated from DB by RefreshSidebar; hidden when
                             no tags exist yet. -->
                        <StackPanel x:Name="TagsHeader" Visibility="Collapsed" Margin="0,8,0,0">
                            <Button Tag="Tags" Click="Вкл.SidebarSectionToggle"
                                    Style="{StaticResource SidebarSectionHeaderStyle}"
                                    Margin="8,4,8,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🏷  TAGS" CharacterSpacing="150"/>
                                    <TextBlock x:Name="TagsChevron" Grid.Column="1"
                                               Text="⌃" FontSize="11" Margin="6,0,0,0"/>
                                </Grid>
                            </Button>
                            <StackPanel x:Name="TagsItemsPanel"/>
                        </StackPanel>

                        <!-- Медиатеки section (collapsible, custom header) -->
                        <StackPanel x:Name="МедиатекиHeader" Visibility="Collapsed" Margin="0,8,0,0">
                            <Button Tag="Медиатеки" Click="Вкл.SidebarSectionToggle"
                                    Style="{StaticResource SidebarSectionHeaderStyle}"
                                    Margin="8,4,8,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="МЕДИАТЕКИ" CharacterSpacing="150"/>
                                    <TextBlock x:Name="МедиатекиChevron" Grid.Column="1"
                                               Text="⌃" FontSize="11" Margin="6,0,0,0"/>
                                </Grid>
                            </Button>
                            <ItemsRepeater x:Name="ДискиRepeater">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:DriveInfo">
                                        <Button Style="{StaticResource NavItemStyle}"
                                                Tag="{Binding VolumeSerial}"
                                                Click="Вкл.NavDriveItem">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="8" Height="8"
                                                         Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <Ellipse.Fill>
                                                        <SolidColorBrush Color="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}}"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <Border Grid.Column="2" Style="{StaticResource BadgeStyle}">
                                                    <TextBlock Text="{Binding MovieCount}" FontSize="11"
                                                               Foreground="{ThemeResource MutedBrush}"
                                                               HorizontalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>

                        <!-- v2.1: TOP GENRES + COLLECTIONS sub-sections removed.
                             Both are now first-class pages under the ОБЗОР section
                             (По жанру, Коллекции), which is richer (banner cards,
                             poster grid) than the previous flat sidebar list. -->

                    </StackPanel>
                </ScrollViewer>

                <!-- v2.5.1 footer: tool row only. Продолжительность / Avg Рейтинг tiles
                     were moved out of the sidebar — they live on the
                     Статистика page where they have proper context. -->
                <Border x:Name="FooterPanel" Grid.Row="2"
                        Margin="10,8,10,10" Padding="0"
                        Назадground="Transparent"
                        BorderThickness="0">
                    <StackPanel Spacing="8">
                        <!-- Tool row — drives / theme / settings / help / collapse, all icon-only.
                             v3.0.0: theme button is now a monochrome FontIcon (matches
                             the others) instead of a colour emoji, and a Настройки gear
                             was added. v3.9.0: Диски moved here from ИНСТРУМЕНТЫ. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnДиски" Grid.Column="1" Click="Вкл.NavДиски"
                                    Назадground="Transparent" BorderThickness="0"
                                    Foreground="{ThemeResource MutedBrush}"
                                    Padding="6" CornerRadius="6"
                                    AutomationProperties.Name="Диски"
                                    ToolTipService.ToolTip="Диски">
                                <FontIcon Glyph="&#xEDA2;" FontSize="15"
                                          FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                            </Button>
                            <Button x:Name="ThemeBtn" Grid.Column="2" Click="Вкл.ToggleTheme"
                                    Назадground="Transparent" BorderThickness="0"
                                    Foreground="{ThemeResource MutedBrush}"
                                    Padding="6" Margin="2,0,0,0" CornerRadius="6"
                                    AutomationProperties.Name="Сменить тему"
                                    ToolTipService.ToolTip="Сменить тему">
                                <FontIcon x:Name="ThemeIcon" Glyph="&#xE706;" FontSize="15"
                                          FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                            </Button>
                            <Button x:Name="НастройкиBtn" Grid.Column="3" Click="Вкл.НастройкиClick"
                                    Назадground="Transparent" BorderThickness="0"
                                    Foreground="{ThemeResource MutedBrush}"
                                    Padding="6" Margin="2,0,0,0" CornerRadius="6"
                                    AutomationProperties.Name="Настройки"
                                    ToolTipService.ToolTip="Настройки">
                                <FontIcon Glyph="&#xE713;" FontSize="15"
                                          FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                            </Button>
                            <Button Grid.Column="4" Click="Вкл.HelpClick"
                                    Назадground="Transparent" BorderThickness="0"
                                    Foreground="{ThemeResource MutedBrush}"
                                    Padding="6" Margin="2,0,0,0" CornerRadius="6"
                                    AutomationProperties.Name="Горячие клавиши"
                                    ToolTipService.ToolTip="Горячие клавиши">
                                <FontIcon Glyph="&#xE897;" FontSize="14"
                                          FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                            </Button>
                            <Button x:Name="SidebarToggleBtn" Grid.Column="5" Click="Вкл.ToggleSidebar"
                                    Назадground="Transparent" BorderThickness="0"
                                    Foreground="{ThemeResource MutedBrush}"
                                    Padding="6" Margin="2,0,0,0" CornerRadius="6"
                                    AutomationProperties.Name="Свернуть боковую панель"
                                    ToolTipService.ToolTip="Свернуть боковую панель">
                                <FontIcon x:Name="SidebarToggleIcon" Glyph="&#xE8A0;" FontSize="16"
                                          FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
            </Border>

            <!-- ═══ MAIN CONTENT ═══ -->
            <!-- Floating OPAQUE content panel on the Mica window: Mica frames it
                 (and the sidebar) for the full Mica look, while the scrolling
                 grid stays opaque so it never composites over Mica → fast. -->
            <Border x:Name="ContentCard" Grid.Column="1" Назадground="{ThemeResource BgBrush}"
                    Margin="4,4,8,8" CornerRadius="12"
                    BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1"
                    Translation="0,0,24">
                <Border.Shadow>
                    <ThemeShadow/>
                </Border.Shadow>
                <Frame x:Name="ContentFrame" Назадground="Transparent"/>
            </Border>

<!-- v2.5.1: reopen toggle moved into AppНазваниеBar above to avoid
                 overlapping the active page's title row. -->


            <!-- ═══ TOAST ═══ v2.6 — slides up from below on show -->
            <Border x:Name="ToastBorder" Grid.Column="1"
                    VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Margin="0,0,20,20" Visibility="Collapsed"
                    Назадground="{ThemeResource ToastBgBrush}" CornerRadius="10" Padding="16,12"
                    BorderBrush="{StaticResource BrandPurpleBrush}" BorderThickness="1">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToastSlide" Y="20"/>
                </Border.RenderTransform>
                <Border.Shadow>
                    <ThemeShadow/>
                </Border.Shadow>
                <Border.Translation>0,0,32</Border.Translation>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock x:Name="ToastText" Foreground="{ThemeResource TextBrush}"
                               VerticalAlignment="Center" FontSize="13"/>
                    <Button x:Name="ToastActionBtn" Click="Вкл.ToastActionClick"
                            Visibility="Collapsed"
                            Назадground="{StaticResource BrandPurpleBrush}"
                            Foreground="#FFFFFF" BorderThickness="0"
                            CornerRadius="6" Padding="10,4" FontSize="12"
                            VerticalAlignment="Center"/>
                    <Button Content="✕" Click="Вкл.ToastDismiss"
                            Назадground="Transparent" BorderThickness="0"
                            Foreground="{ThemeResource MutedBrush}" Padding="4" FontSize="12"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
