<ContentDialog
    x:Class="CineМедиатекаCS.Views.ДобавитьПросмотреноMovieDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CineМедиатекаCS.Views"
    Название="Добавить a watched movie"
    PrimaryButtonText="Добавить в «Просмотрено и удалено»"
    ЗакрытьButtonText="Отмена"
    По умолчаниюButton="Primary"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonClick="Вкл.Добавить">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560" Padding="0,0,16,0">
        <StackPanel Spacing="10" MinWidth="460">

            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource MutedBrush}"
                       Text="Просмотрено a film somewhere else — at the cinema, on a streaming service, a friend's copy — and want it on record? Find it on TMDb, add your note, and it's saved here as a Просмотрено и удалено record. No file needed."/>

            <!-- Поиск row -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="НазваниеBox" Grid.Column="0" PlaceholderText="Movie title…"
                         KeyDown="Вкл.НазваниеKeyDown"/>
                <TextBox x:Name="ГодBox" Grid.Column="1" PlaceholderText="Год" Width="72"
                         MaxLength="4" InputScope="Number"/>
                <Button x:Name="ПоискBtn" Grid.Column="2" Content="Поиск" Click="Вкл.Поиск"
                        Style="{ThemeResource AccentButtonStyle}"/>
            </Grid>

            <!-- Status / busy -->
            <Grid>
                <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20"
                              HorizontalAlignment="Left"/>
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="{ThemeResource MutedBrush}"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>

            <!-- Results -->
            <ListView x:Name="ResultsList" Height="220" SelectionMode="Single"
                      SelectionChanged="Вкл.ResultSelected"
                      BorderBrush="{ThemeResource InputBorderBrush}" BorderThickness="1"
                      CornerRadius="8" Visibility="Collapsed">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:TmdbResultItem">
                        <Grid ColumnSpacing="10" Padding="2,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="46" Height="69" CornerRadius="4"
                                    Назадground="{ThemeResource InputBgBrush}">
                                <Image Source="{x:Bind Thumb}" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind DisplayНазвание}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextBrush}"/>
                                <TextBlock Text="{x:Bind SubLine}" FontSize="12"
                                           Foreground="{ThemeResource MutedBrush}"/>
                                <TextBlock Text="{x:Bind Overview}" FontSize="12"
                                           Foreground="{ThemeResource MutedBrush}"
                                           TextWrapping="Wrap" MaxLines="2"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Record fields -->
            <TextBox x:Name="NoteBox" Header="Ваша заметка (необязательно)"
                     PlaceholderText="Почему вам понравился фильм, где вы его смотрели…"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="72"/>
            <TextBox x:Name="TagsBox" Header="Теги (необязательно, через запятую)"
                     PlaceholderText="e.g. drama, rewatch"/>
            <CalendarDatePicker x:Name="ПросмотреноDate" Header="Просмотрено on" HorizontalAlignment="Left"/>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
