<Page
    x:Class="CineМедиатекаCS.Views.КоллекцииОбзорPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CineМедиатекаCS.Views"
    xmlns:controls="using:CineМедиатекаCS.Controls"
    Назадground="{ThemeResource BgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: one row (v3.9.0), like Все фильмы: title + count |
             watched pills | sort + poster size. HeaderBar wraps it when narrow. -->
        <controls:HeaderBar Grid.Row="0" Margin="24,8,24,10" HorizontalSpacing="16" VerticalSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="Коллекции" FontSize="24" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextBrush}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="PageCountText" Text=""
                           FontSize="13" Foreground="{ThemeResource MutedBrush}"
                           VerticalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- v3.8.0: watched filter, same pills as Все фильмы. -->
            <StackPanel x:Name="CollFilterPills" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                <Button x:Name="CollFilterВсе" Content="Все" Tag="all"
                        Style="{StaticResource PillButtonActiveStyle}" Click="Вкл.FilterClick"/>
                <Button x:Name="CollFilterНе просмотрено" Content="Не просмотрено" Tag="unwatched"
                        Style="{StaticResource PillButtonStyle}" Click="Вкл.FilterClick"
                        ToolTipService.ToolTip="Коллекции с непросмотренными фильмами"/>
                <Button x:Name="CollFilterПросмотрено" Content="Просмотрено" Tag="watched"
                        Style="{StaticResource PillButtonStyle}" Click="Вкл.FilterClick"
                        ToolTipService.ToolTip="Коллекции, в которых вы просмотрели все фильмы"/>
            </StackPanel>

            <!-- v3.8.0: sort + poster size, matching Все фильмы. -->
            <StackPanel x:Name="CollToolbar" Orientation="Horizontal" Spacing="12"
                        VerticalAlignment="Center">
                <ComboBox x:Name="CollSortCombo"
                          SelectionChanged="Вкл.SortChanged"
                          Назадground="{ThemeResource InputBgBrush}"
                          Foreground="{ThemeResource TextBrush}"
                          BorderBrush="{ThemeResource InputBorderBrush}"
                          Width="160" Height="36" CornerRadius="8"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="Sort collections">
                    <ComboBoxItem Tag="name:asc"        Content="Имя ↑"/>
                    <ComboBoxItem Tag="name:desc"       Content="Имя ↓"/>
                    <ComboBoxItem Tag="count:desc"      Content="Фильмы ↓"/>
                    <ComboBoxItem Tag="count:asc"       Content="Фильмы ↑"/>
                    <ComboBoxItem Tag="year:desc"       Content="Год ↓"/>
                    <ComboBoxItem Tag="year:asc"        Content="Год ↑"/>
                    <ComboBoxItem Tag="date_added:desc" Content="Дата добавления ↓"/>
                    <ComboBoxItem Tag="date_added:asc"  Content="Дата добавления ↑"/>
                </ComboBox>
                <DropDownButton Назадground="{ThemeResource InputBgBrush}"
                                Foreground="{ThemeResource TextBrush}"
                                BorderBrush="{ThemeResource InputBorderBrush}"
                                CornerRadius="8" Height="36" Padding="12,0,10,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Размер постера"
                                ToolTipService.ToolTip="Размер постера">
                    <TextBlock x:Name="CollDensityLabel" Text="Size: M" FontSize="13"/>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <RadioMenuFlyoutItem x:Name="CollDensityS" Text="Маленький" Tag="S" GroupName="colldensity"
                                                 KeyboardAcceleratorTextOverride="S" Click="Вкл.DensityClick"/>
                            <RadioMenuFlyoutItem x:Name="CollDensityM" Text="Средний" Tag="M" GroupName="colldensity"
                                                 KeyboardAcceleratorTextOverride="M" Click="Вкл.DensityClick"/>
                            <RadioMenuFlyoutItem x:Name="CollDensityL" Text="Большой" Tag="L" GroupName="colldensity"
                                                 KeyboardAcceleratorTextOverride="L" Click="Вкл.DensityClick"/>
                            <RadioMenuFlyoutItem x:Name="CollDensityXL" Text="Очень большой" Tag="XL" GroupName="colldensity"
                                                 KeyboardAcceleratorTextOverride="XL" Click="Вкл.DensityClick"/>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </controls:HeaderBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsRepeater x:Name="GridRepeater" Margin="24,0,24,24">
                    <ItemsRepeater.Layout>
                        <!-- Card sizes follow the S / M / L / XL picker, the
                             same sizes as Все фильмы (M = 150×280). -->
                        <UniformGridLayout x:Name="CollGridLayout" MinItemWidth="150" MinItemHeight="280"
                                           MinColumnSpacing="12" MinRowSpacing="12"
                                           ItemsStretch="Fill"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <!-- v3.8.0: built like a movie card. The poster fills the
                             card, the name and count sit on a dark strip at the
                             bottom, and a green tick marks a fully watched set. -->
                        <DataTemplate x:DataType="local:CollectionTileVm">
                            <Button Назадground="Transparent" BorderThickness="0"
                                    Padding="0" CornerRadius="10"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Click="Вкл.TileClick"
                                    Tag="{x:Bind Id}"
                                    AutomationProperties.Name="{x:Bind Name}">
                                <Border Width="{x:Bind CardWidth}" Height="{x:Bind CardHeight}"
                                        CornerRadius="10"
                                        Назадground="{ThemeResource PlaceholderBgBrush}"
                                        BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="🎬" FontSize="42" Opacity="0.6"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Stretch="UniformToFill"
                                               Source="{x:Bind CoverImage, Mode=Вкл.eWay}"/>
                                        <Border VerticalAlignment="Bottom" CornerRadius="0,0,10,10" Padding="8,6">
                                            <Border.Назадground>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Выкл.set="0" Color="#00000000"/>
                                                    <GradientStop Выкл.set="0.3" Color="#B3000000"/>
                                                    <GradientStop Выкл.set="1" Color="#FF000000"/>
                                                </LinearGradientBrush>
                                            </Border.Назадground>
                                            <StackPanel VerticalAlignment="Bottom" Spacing="2">
                                                <Border Назадground="#CC22C55E" CornerRadius="10"
                                                        Width="22" Height="22" Margin="0,0,0,4"
                                                        HorizontalAlignment="Left"
                                                        Visibility="{x:Bind ПросмотреноVisibility}">
                                                    <TextBlock Text="✓" FontSize="12" FontWeight="Bold" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{x:Bind Name}"
                                                           FontSize="12" FontWeight="Bold"
                                                           Foreground="White"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="WrapWholeWords"
                                                           MaxLines="2"/>
                                                <TextBlock Text="{x:Bind CountText}"
                                                           FontSize="11" Foreground="#D8D8D8"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Margin="0,80,0,24" Spacing="8">
                    <FontIcon Glyph="&#xE8B7;" FontSize="44" Opacity="0.5"
                              FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"
                              Foreground="{ThemeResource MutedBrush}"
                              HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyНазвание" Text="Коллекций пока нет"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyHint" Text="MediaElch collections (franchises, sagas) appear here once at least two of their movies are in your library and tagged in their .nfo files."
                               FontSize="12" Foreground="{ThemeResource MutedBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="380"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
