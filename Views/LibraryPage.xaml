<Page
    x:Class="CineМедиатекаCS.Views.МедиатекаPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CineМедиатекаCS.Views"
    xmlns:models="using:CineМедиатекаCS.Models"
    xmlns:controls="using:CineМедиатекаCS.Controls"
    Назадground="{ThemeResource BgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ TOP BAR ═══ -->
        <!-- v3.9.0: one row, as in Aryan: title + count | watched pills | tools.
             In a narrow window HeaderBar moves the pills, then the tools, onto
             their own line. Clear filters lives on the chips line below, so a
             pill click never changes this row's width. -->
        <Grid Grid.Row="0">
            <controls:HeaderBar Margin="24,8,24,10" HorizontalSpacing="16" VerticalSpacing="8">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <!-- v2.7 — "back to Обзор" button. Appears only when the
                         library view was drilled into from a Обзор banner (By
                         Genre / Decade / Рейтинг / Студия) or Коллекции; returns
                         to that page. Hidden for Все фильмы / Избранное / etc. -->
                    <Button x:Name="НазадToggleBtn"
                            Click="Вкл.ОбзорНазадClick"
                            Назадground="{ThemeResource InputBgBrush}"
                            BorderBrush="{ThemeResource InputBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,6"
                            Height="36"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="‹" FontSize="18" FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextBrush}"/>
                            <TextBlock x:Name="НазадLabel" Text="Назад" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextBrush}"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="PageНазваниеText" Text="Все фильмы"
                               FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <!-- MinWidth keeps the pills still while the count changes. -->
                    <TextBlock x:Name="MovieCountText" Text="0 movies" MinWidth="88"
                               Foreground="{ThemeResource MutedBrush}" FontSize="13"
                               VerticalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="FilterВсе"      Content="Все"       Tag="all"
                            Style="{StaticResource PillButtonActiveStyle}" Click="Вкл.ПросмотреноFilter"/>
                    <Button x:Name="FilterНе просмотрено" Content="Не просмотрено" Tag="unwatched"
                            Style="{StaticResource PillButtonStyle}"       Click="Вкл.ПросмотреноFilter"/>
                    <Button x:Name="FilterПросмотрено"  Content="Просмотрено"   Tag="watched"
                            Style="{StaticResource PillButtonStyle}"       Click="Вкл.ПросмотреноFilter"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <ComboBox x:Name="SortCombo"
                              SelectionChanged="Вкл.SortChanged"
                              Назадground="{ThemeResource InputBgBrush}"
                              Foreground="{ThemeResource TextBrush}"
                              BorderBrush="{ThemeResource InputBorderBrush}"
                              Width="160"
                              Height="36"
                              CornerRadius="8"
                              VerticalAlignment="Center">
                        <ComboBoxItem Tag="title:asc"      Content="Название ↑"/>
                        <ComboBoxItem Tag="title:desc"     Content="Название ↓"/>
                        <ComboBoxItem Tag="year:desc"      Content="Год ↓"/>
                        <ComboBoxItem Tag="year:asc"       Content="Год ↑"/>
                        <ComboBoxItem Tag="rating:desc"    Content="Рейтинг ↓"/>
                        <ComboBoxItem Tag="rating:asc"     Content="Рейтинг ↑"/>
                        <ComboBoxItem Tag="runtime:desc"   Content="Продолжительность ↓"/>
                        <ComboBoxItem Tag="runtime:asc"    Content="Продолжительность ↑"/>
                        <ComboBoxItem Tag="date_added:desc" Content="Дата добавления ↓"/>
                        <ComboBoxItem Tag="date_added:asc"  Content="Дата добавления ↑"/>
                        <ComboBoxItem Tag="last_played:desc" Content="Последний просмотр ↓"/>
                        <ComboBoxItem Tag="last_played:asc"  Content="Последний просмотр ↑"/>
                    </ComboBox>

                    <!-- v2.9 — Surprise Me 🎲: filter-aware random pick. Honours
                         whatever is currently filtered/searched/listed, so you
                         can "random pick from current view". The existing
                         sidebar 'Удиви меня' stays as the unfiltered version. -->
                    <Button x:Name="SurpriseMeBtn" Click="Вкл.SurpriseMeClick"
                            Назадground="{ThemeResource InputBgBrush}"
                            Foreground="{ThemeResource TextBrush}"
                            BorderBrush="{ThemeResource InputBorderBrush}"
                            CornerRadius="8"
                            Padding="10,8"
                            Height="36" Width="36"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Удиви меня"
                            ToolTipService.ToolTip="Удиви меня — случайный выбор из текущего представления">
                        <FontIcon Glyph="&#xE8B1;" FontSize="15"
                                  FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <!-- View mode — segmented (grid / list) -->
                    <Border Назадground="{ThemeResource InputBgBrush}"
                            BorderBrush="{ThemeResource InputBorderBrush}"
                            BorderThickness="1" CornerRadius="8"
                            Height="36" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="GridViewToggle" IsChecked="True"
                                          Click="Вкл.ViewGrid"
                                          AutomationProperties.Name="Вид сеткой"
                                          Назадground="Transparent" BorderThickness="0"
                                          Padding="0" Height="36" Width="36"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          ToolTipService.ToolTip="Вид сеткой">
                                <FontIcon Glyph="&#xE8A9;" FontSize="16"
                                          FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                            </ToggleButton>
                            <ToggleButton x:Name="ListViewToggle"
                                          Click="Вкл.ViewList"
                                          AutomationProperties.Name="Вид списком"
                                          Назадground="Transparent" BorderThickness="0"
                                          Padding="0" Height="36" Width="36"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          ToolTipService.ToolTip="Вид списком">
                                <FontIcon Glyph="&#xE8FD;" FontSize="16"
                                          FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                            </ToggleButton>
                        </StackPanel>
                    </Border>


                    <!-- v3.9.0: poster size is a drop-down (was S / M / L / XL buttons). -->
                    <DropDownButton x:Name="DensityDropDown"
                                    Назадground="{ThemeResource InputBgBrush}"
                                    Foreground="{ThemeResource TextBrush}"
                                    BorderBrush="{ThemeResource InputBorderBrush}"
                                    CornerRadius="8" Height="36" Padding="12,0,10,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Размер постера"
                                    ToolTipService.ToolTip="Размер постера">
                        <TextBlock x:Name="DensityLabel" Text="Size: M" FontSize="13"/>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <RadioMenuFlyoutItem x:Name="DensityS" Text="Маленький" Tag="S" GroupName="density"
                                                     KeyboardAcceleratorTextOverride="S" Click="Вкл.DensityClick"/>
                                <RadioMenuFlyoutItem x:Name="DensityM" Text="Средний" Tag="M" GroupName="density"
                                                     KeyboardAcceleratorTextOverride="M" Click="Вкл.DensityClick"/>
                                <RadioMenuFlyoutItem x:Name="DensityL" Text="Большой" Tag="L" GroupName="density"
                                                     KeyboardAcceleratorTextOverride="L" Click="Вкл.DensityClick"/>
                                <RadioMenuFlyoutItem x:Name="DensityXL" Text="Очень большой" Tag="XL" GroupName="density"
                                                     KeyboardAcceleratorTextOverride="XL" Click="Вкл.DensityClick"/>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>
            </controls:HeaderBar>

            <!-- v3.2 — in-page search moved to the global title-bar search.
                 This box is kept (collapsed) as the page's internal engine so
                 existing focus/clear wiring keeps working. -->
            <Grid ColumnSpacing="8" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- v3.1 — search scope: narrow what the box matches. -->
                <ComboBox Grid.Column="0" x:Name="ScopeCombo"
                          SelectionChanged="Вкл.ScopeChanged"
                          SelectedIndex="0"
                          MinWidth="96" Height="36"
                          VerticalAlignment="Center"
                          CornerRadius="8"
                          Назадground="{ThemeResource InputBgBrush}"
                          Foreground="{ThemeResource TextBrush}"
                          BorderBrush="{ThemeResource InputBorderBrush}"
                          ToolTipService.ToolTip="Результаты поиска">
                    <ComboBoxItem Tag="all"   Content="Все"/>
                    <ComboBoxItem Tag="title" Content="Название"/>
                    <ComboBoxItem Tag="cast"  Content="Актёры и съёмочная группа"/>
                </ComboBox>
                <AutoSuggestBox Grid.Column="1"
                                x:Name="ПоискBox"
                                PlaceholderText="Поиск названия, актёра, режиссёра…"
                                QueryIcon="Find"
                                TextChanged="Вкл.ПоискChanged"
                                GotFocus="Вкл.ПоискBoxFocus"
                                LostFocus="Вкл.ПоискBoxBlur"
                                CornerRadius="8"
                                Назадground="{ThemeResource InputBgBrush}"
                                BorderBrush="{ThemeResource InputBorderBrush}"
                                Foreground="{ThemeResource TextBrush}"/>
                <Border x:Name="ПоискEscHint" Grid.Column="2" Visibility="Collapsed"
                        Назадground="{ThemeResource ChipBrush}"
                        BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="6,2" Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                    <TextBlock Text="Esc" FontSize="10" FontWeight="SemiBold"
                               Foreground="{ThemeResource MutedBrush}"
                               CharacterSpacing="50"/>
                </Border>
            </Grid>

        </Grid>

        <!-- ═══ FILTER CHIPS ═══ -->
        <!-- Active filters as removable chips, then Clear filters. Collapses
             to nothing when no filter is on. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Padding="24,0">
            <!-- v2.6 — Active filter chips. Each one removes itself when
                 clicked, so the user can drop a single filter without
                 hunting through menus. -->
            <ItemsControl x:Name="ActiveFilterChips" Visibility="Collapsed" Margin="0,0,0,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Button x:Name="ClearFiltersBtn" Content="✕ Очистить фильтры"
                    Click="Вкл.ClearFilters" Visibility="Collapsed"
                    Style="{StaticResource PillButtonStyle}"
                    VerticalAlignment="Top" Margin="0,0,0,8"/>
        </StackPanel>

        <!-- ═══ MOVIE GRID / LIST ═══ -->
        <ScrollViewer Grid.Row="2" x:Name="MainScroller"
                      VerticalScrollBarVisibility="Auto"
                      ViewChanged="Вкл.ScrollChanged">
          <StackPanel>
            <!-- v2.9 — Сериалы matching the current search query.
                 Sits at the very top of the page when the user types
                 something the search picks up across both movies and
                 shows. Hidden when search is empty. -->
            <StackPanel x:Name="ShowsInПоискSection" Visibility="Collapsed" Spacing="8" Margin="0,0,0,8">
                <TextBlock x:Name="ShowsInПоискHeader" Text="ПОДХОДЯЩИЕ СЕРИАЛЫ"
                           Margin="24,4,24,0"
                           FontSize="12" FontWeight="SemiBold" CharacterSpacing="150"
                           Opacity="0.75"
                           Foreground="{ThemeResource MutedBrush}"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"
                              Height="312" Padding="24,0,24,0">
                    <ItemsRepeater x:Name="ShowsInПоискRepeater">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="14"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:TvShowListItem">
                                <local:TvShowCard Show="{x:Bind}"/>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </StackPanel>

            <!-- v2.8.2 — when viewing a user list that also contains TV
                 shows, show them as a row at the top (lists are independent
                 buckets that hold both movies and shows). v4.0.0: the same
                 row shows the shows on Избранное, К просмотру and Продолжить просмотр. -->
            <StackPanel x:Name="ShowsInListSection" Visibility="Collapsed" Spacing="8" Margin="0,0,0,8">
                <TextBlock x:Name="ShowsInListHeader" Text="СЕРИАЛЫ В ЭТОМ СПИСКЕ" Margin="24,4,24,0"
                           FontSize="12" FontWeight="SemiBold" CharacterSpacing="150"
                           Opacity="0.7" Foreground="{ThemeResource MutedBrush}"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"
                              Padding="24,0,24,0">
                    <ItemsRepeater x:Name="ShowsInListRepeater">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="14"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:TvShowListItem">
                                <local:TvShowCard Show="{x:Bind}"/>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </StackPanel>

            <Grid>
                <!-- Empty state -->
                <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Spacing="10" Margin="24,80,24,24" MaxWidth="440">
                    <TextBlock x:Name="EmptyIcon" Text="🎬" FontSize="56"
                               HorizontalAlignment="Center" Opacity="0.5"/>
                    <TextBlock x:Name="EmptyНазвание" Text="Нет фильмов, соответствующих фильтрам"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock x:Name="EmptyStateHint"
                               Text="Попробуйте очистить поиск или выбрать фильтр «Все»."
                               FontSize="13" Foreground="{ThemeResource MutedBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap"/>
                    <Button x:Name="EmptyCtaBtn" Visibility="Collapsed"
                            Click="Вкл.EmptyCtaClick"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0"
                            Назадground="{StaticResource BrandPurpleBrush}"
                            Foreground="#FFFFFF"
                            BorderThickness="0"
                            CornerRadius="8" Padding="16,8"/>
                </StackPanel>

                <!-- Grid View -->
                <Border x:Name="GridBorder" Padding="24,0,24,24">
                    <ItemsRepeater x:Name="GridRepeater">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout x:Name="GridLayout"
                                               MinItemWidth="150" MinItemHeight="280"
                                               MinColumnSpacing="12" MinRowSpacing="12"
                                               ItemsStretch="Fill"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:MovieListItem">
                                <local:MovieCardControl Movie="{x:Bind}"/>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Border>

                <!-- List View -->
                <Border x:Name="ListBorder" Padding="24,0,24,24" Visibility="Collapsed">
                    <ItemsRepeater x:Name="ListRepeater">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="2"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:MovieListItem">
                                <local:MovieRowControl Movie="{x:Bind}"/>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <!-- Loading indicator -->
        <ProgressRing x:Name="LoadingRing"
                      Grid.Row="2"
                      Width="40" Height="40"
                      Foreground="{StaticResource BrandPurpleBrush}"
                      HorizontalAlignment="Center" VerticalAlignment="Bottom"
                      Margin="0,0,0,20"
                      IsActive="False" Visibility="Collapsed"/>

        <!-- ═══ MULTI-SELECT BOTTOM ACTION BAR (v2.5) ═══ -->
        <!-- Appears the moment ≥1 cards are selected. Floats centered above
             the bottom edge so it never blocks scrolling/clicking. -->
        <Border x:Name="SelectionBar" Grid.Row="2"
                Visibility="Collapsed"
                VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,18" Padding="14,8"
                Назадground="{ThemeResource CardBrush}"
                BorderBrush="{StaticResource BrandPurpleBrush}"
                BorderThickness="1" CornerRadius="22">
            <!-- v2.6 — slides up from below when selection becomes non-empty -->
            <Border.RenderTransform>
                <TranslateTransform x:Name="SelectionBarSlide" Y="40"/>
            </Border.RenderTransform>
            <Border.Shadow>
                <ThemeShadow/>
            </Border.Shadow>
            <Border.Translation>0,0,32</Border.Translation>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock x:Name="SelectionCountText"
                           Foreground="{ThemeResource TextBrush}"
                           FontWeight="SemiBold" FontSize="13"
                           VerticalAlignment="Center" Margin="4,0,4,0"/>
                <Button x:Name="SelДобавитьToListBtn" Content="📑 Добавить в список ▾"
                        Назадground="{StaticResource BrandPurpleBrush}"
                        Foreground="White" BorderThickness="0"
                        CornerRadius="8" Padding="12,6" FontSize="12">
                    <Button.Flyout>
                        <MenuFlyout x:Name="SelListsFlyout" Placement="Top"
                                    Opening="Вкл.SelListsFlyoutOpening"/>
                    </Button.Flyout>
                </Button>
                <Button x:Name="SelПросмотреноBtn" Click="Вкл.SelToggleПросмотрено"
                        Content="✓ Просмотрено"
                        Назадground="{ThemeResource CardBrush}"
                        Foreground="{ThemeResource TextBrush}"
                        BorderBrush="{ThemeResource BorderBrush}"
                        CornerRadius="8" Padding="10,6" FontSize="12"/>
                <Button x:Name="SelСписок просмотраBtn" Click="Вкл.SelToggleСписок просмотра"
                        Content="📌 Список просмотра"
                        Назадground="{ThemeResource CardBrush}"
                        Foreground="{ThemeResource TextBrush}"
                        BorderBrush="{ThemeResource BorderBrush}"
                        CornerRadius="8" Padding="10,6" FontSize="12"/>
                <Button x:Name="SelFavBtn" Click="Вкл.SelToggleFav"
                        Content="★ В избранное"
                        Назадground="{ThemeResource CardBrush}"
                        Foreground="{ThemeResource TextBrush}"
                        BorderBrush="{ThemeResource BorderBrush}"
                        CornerRadius="8" Padding="10,6" FontSize="12"/>
                <Button x:Name="SelArchiveBtn" Click="Вкл.SelArchive"
                        Назадground="{ThemeResource CardBrush}"
                        Foreground="{ThemeResource TextBrush}"
                        BorderBrush="{ThemeResource BorderBrush}"
                        CornerRadius="8" Padding="10,6" FontSize="12"
                        AutomationProperties.Name="Send to Просмотрено and Gone"
                        ToolTipService.ToolTip="Оставить as a record, remove from library">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7B8;" FontSize="12"
                                  FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                        <TextBlock Text="Просмотрено и удалено" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="SelRemoveFromListBtn" Click="Вкл.SelRemoveFromCurrentList"
                        Content="🗑 Remove from list"
                        Visibility="Collapsed"
                        Назадground="{ThemeResource CardBrush}"
                        Foreground="{ThemeResource TextBrush}"
                        BorderBrush="{ThemeResource BorderBrush}"
                        CornerRadius="8" Padding="10,6" FontSize="12"/>
                <Button Click="Вкл.SelClear" Content="✕"
                        Назадground="Transparent"
                        Foreground="{ThemeResource MutedBrush}"
                        BorderThickness="0" CornerRadius="8" Padding="8,6" FontSize="12"
                        ToolTipService.ToolTip="Снять выделение (Esc)"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
