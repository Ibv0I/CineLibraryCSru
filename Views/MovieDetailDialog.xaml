<Window
    x:Class="CineМедиатекаCS.Views.MovieDetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CineМедиатекаCS.Models"
    xmlns:controls="using:CineМедиатекаCS.Controls"
    Название="Информация о фильме">

    <Grid x:Name="RootGrid" Назадground="{ThemeResource SidebarBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom titlebar drag region -->
        <Grid x:Name="AppНазваниеBar" Grid.Row="0" Назадground="Transparent">
            <TextBlock x:Name="НазваниеBarText" Text="Информация о фильме"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextBrush}"
                       VerticalAlignment="Center" Margin="14,0,0,0"/>
        </Grid>

        <!-- Scroll area + sticky action bar overlay (v2.3) -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="ContentScroller" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="24"
                          ViewChanged="Вкл.ContentScrolled" SizeChanged="Вкл.ContentScrollerSizeChanged">
            <!-- v4.2.0 (#14): fills the window. The code picks a narrow, standard
                 or wide arrangement from the width (Вкл.ContentScrollerSizeChanged). -->
            <StackPanel x:Name="ContentStack" HorizontalAlignment="Stretch">

                <!-- Hero fanart (v2.3 — taller, layered gradient, vignette, IMDb/TMDb pills) -->
                <Border x:Name="HeroBorder" Height="340" CornerRadius="12"
                        Назадground="{ThemeResource HeroBgBrush}"
                        HorizontalAlignment="Stretch">
                    <Grid>
                        <Image x:Name="HeroImage" Stretch="UniformToFill"/>
                        <!-- Vertical gradient — strong on the bottom so titles stay readable -->
                        <Border>
                            <Border.Назадground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Выкл.set="0"    Color="#33000000"/>
                                    <GradientStop Выкл.set="0.55" Color="#22000000"/>
                                    <GradientStop Выкл.set="1"    Color="#E6000000"/>
                                </LinearGradientBrush>
                            </Border.Назадground>
                        </Border>
                        <!-- Horizontal vignette — subtle edge darkening -->
                        <Border>
                            <Border.Назадground>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Выкл.set="0"    Color="#55000000"/>
                                    <GradientStop Выкл.set="0.5"  Color="#00000000"/>
                                    <GradientStop Выкл.set="1"    Color="#55000000"/>
                                </LinearGradientBrush>
                            </Border.Назадground>
                        </Border>
                        <!-- IMDb / TMDb badge pills, top-right -->
                        <StackPanel x:Name="ExternalLinksPanel" Orientation="Horizontal"
                                    Spacing="6" Margin="14"
                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button x:Name="ImdbLinkBtn" Visibility="Collapsed"
                                    Click="Вкл.OpenImdb"
                                    Назадground="#F5C518" Foreground="#000000"
                                    BorderThickness="0" CornerRadius="4"
                                    Padding="8,3" FontSize="11" FontWeight="Bold"
                                    Content="IMDb"/>
                            <Button x:Name="TmdbLinkBtn" Visibility="Collapsed"
                                    Click="Вкл.OpenTmdb"
                                    Назадground="#01D277" Foreground="#000000"
                                    BorderThickness="0" CornerRadius="4"
                                    Padding="8,3" FontSize="11" FontWeight="Bold"
                                    Content="TMDb"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Poster + Meta row -->
                <Grid x:Name="TopGrid" Margin="0,-120,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="0"/>
                    </Grid.ColumnDefinitions>

                    <!-- Poster column: poster card + below-poster info card -->
                    <StackPanel Grid.Column="0" Margin="16,0,24,0" VerticalAlignment="Top"
                                Spacing="12">
                        <!-- Poster — drop shadow + thin border for depth -->
                        <Border x:Name="PosterFrame" Width="200" Height="290" CornerRadius="12"
                                BorderBrush="#33FFFFFF" BorderThickness="1"
                                Назадground="{ThemeResource PlaceholderBgBrush}">
                            <Border.Shadow>
                                <ThemeShadow/>
                            </Border.Shadow>
                            <Border.Translation>0,0,32</Border.Translation>
                            <Grid>
                                <TextBlock x:Name="PosterPlaceholder" Text="🎬" FontSize="56"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="PosterImage" Stretch="UniformToFill"/>
                            </Grid>
                        </Border>

                    </StackPanel>

                    <!-- Meta -->
                    <StackPanel x:Name="MetaStack" Grid.Column="1" Spacing="10" VerticalAlignment="Top"
                                Margin="0,140,0,0">
                        <TextBlock x:Name="DetailНазвание" FontSize="34" FontWeight="Bold"
                                   Foreground="{ThemeResource TextBrush}"
                                   TextWrapping="Wrap" LineHeight="40"/>
                        <TextBlock x:Name="OriginalНазвание" FontSize="14" FontStyle="Italic"
                                   Foreground="{ThemeResource MutedBrush}" Visibility="Collapsed"
                                   TextWrapping="Wrap"/>
                        <!-- Tagline with a thin colored accent bar -->
                        <Grid x:Name="TaglineWrap" Visibility="Collapsed" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Назадground="{StaticResource BrandPurpleBrush}"
                                    CornerRadius="2" Margin="0,2,8,2"/>
                            <TextBlock x:Name="Tagline" Grid.Column="1"
                                       FontStyle="Italic" FontSize="14"
                                       Foreground="{StaticResource BrandPurpleBrush}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                        <StackPanel x:Name="ChipsPanel" Orientation="Horizontal" Spacing="6" Margin="0,4,0,0"/>
                        <!-- Tech badges + ratings on the same row to save vertical space -->
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0"
                                    VerticalAlignment="Center">
                            <ItemsControl x:Name="TechBadges" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <StackPanel x:Name="РейтингsPanel" Orientation="Horizontal" Spacing="18"
                                        VerticalAlignment="Center" Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- v4.2.0 (#14): genres, director, studio and file info, beside the
                         plot in a wide window -->
                    <StackPanel x:Name="SideStack" Grid.Column="2" Margin="40,140,0,0"
                                VerticalAlignment="Top"/>
                </Grid>

                <!-- Location, actions, lists and tags: under the poster, or beside it
                     in a wide window (v4.2.0) -->
                <StackPanel x:Name="ActionsBlock">
                    <!-- Drive location -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                        <TextBlock Text="Расположение:" FontSize="12"
                                   Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center"/>
                        <Ellipse x:Name="DriveStatusDot" Width="8" Height="8" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DriveText" FontSize="12"
                                   Foreground="{ThemeResource TextBrush}" VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Actions (wrap onto a second line in narrow windows) -->
                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" Margin="0,12,0,0">
                        <Button x:Name="ВоспроизвестиBtn" Click="Вкл.Воспроизвести"
                                Назадground="#A78BFA" Foreground="White"
                                BorderThickness="0" CornerRadius="8" Padding="16,8">
                            <TextBlock Text="▶ Воспроизвести"/>
                        </Button>
                        <Button x:Name="ПапкаBtn" Content="📂 Открыть папку" Click="Вкл.OpenПапка"
                                Назадground="{ThemeResource CardBrush}"
                                Foreground="{ThemeResource TextBrush}"
                                BorderBrush="{ThemeResource BorderBrush}"
                                CornerRadius="8" Padding="12,8"/>
                        <Button x:Name="FavBtn" Click="Вкл.ToggleFav"
                                Назадground="{ThemeResource CardBrush}"
                                Foreground="{ThemeResource TextBrush}"
                                BorderBrush="{ThemeResource BorderBrush}"
                                CornerRadius="8" Padding="12,8"/>
                        <Button x:Name="ПросмотреноBtn" Click="Вкл.ToggleПросмотрено"
                                Назадground="{ThemeResource CardBrush}"
                                Foreground="{ThemeResource TextBrush}"
                                BorderBrush="{ThemeResource BorderBrush}"
                                CornerRadius="8" Padding="12,8"/>
                        <Button x:Name="Список просмотраBtn" Click="Вкл.ToggleСписок просмотра"
                                Назадground="{ThemeResource CardBrush}"
                                Foreground="{ThemeResource TextBrush}"
                                BorderBrush="{ThemeResource BorderBrush}"
                                CornerRadius="8" Padding="12,8"/>
                        <Button x:Name="ListsBtn" Content="📑 Добавить в список"
                                Назадground="{ThemeResource CardBrush}"
                                Foreground="{ThemeResource TextBrush}"
                                BorderBrush="{ThemeResource BorderBrush}"
                                CornerRadius="8" Padding="12,8">
                            <Button.Flyout>
                                <MenuFlyout x:Name="ListsFlyout" Placement="Bottom" Opening="Вкл.ListsFlyoutOpening"/>
                            </Button.Flyout>
                        </Button>
                    </controls:WrapPanel>

                    <!-- v3.4 — TMDB enrichment: fill gaps in the app, then (for real
                         library movies on an online drive) sync the result home. -->
                    <StackPanel x:Name="TmdbActionsRow" Orientation="Horizontal" Spacing="8"
                                Margin="0,8,0,0" Visibility="Collapsed">
                        <Button x:Name="FetchTmdbBtn" Click="Вкл.FetchMissing"
                                Style="{ThemeResource AccentButtonStyle}"
                                CornerRadius="8" Padding="12,8"
                                ToolTipService.ToolTip="Найти фильм в TMDb и заполнить только недостающие сведения">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE896;" FontSize="14"
                                          FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                                <TextBlock Text="Получить недостающую информацию из TMDB"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SyncDriveBtn" Click="Вкл.SyncToDrive" Visibility="Collapsed"
                                Назадground="{ThemeResource CardBrush}" Foreground="{ThemeResource TextBrush}"
                                BorderBrush="{ThemeResource BorderBrush}" CornerRadius="8" Padding="12,8"
                                ToolTipService.ToolTip="Записать загруженный постер, актёров и сведения в папку фильма на диске">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE895;" FontSize="14"
                                          FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                                <TextBlock Text="Синхронизировать с диском"/>
                            </StackPanel>
                        </Button>
                        <ProgressRing x:Name="TmdbBusy" IsActive="False" Width="18" Height="18"
                                      VerticalAlignment="Center"/>
                        <TextBlock x:Name="TmdbStatus" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{ThemeResource MutedBrush}" Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- v2.5 — Lists this movie is on. Each chip has a ✕ that
                         removes the movie from that list immediately (with Undo
                         in the toast). The whole row hides when there are none. -->
                    <ItemsControl x:Name="ListChipsRepeater" Margin="0,10,0,0" Visibility="Collapsed">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- v2.9 — Free-form tags. Chips with ✕ to remove; an
                         "+ Добавить тег" affordance opens an autocomplete that
                         suggests existing tags and accepts new names. The
                         whole row hides when there are no tags AND the input
                         is collapsed. -->
                    <StackPanel x:Name="TagsRow" Orientation="Horizontal" Spacing="6"
                                Margin="0,10,0,0">
                        <TextBlock Text="🏷" FontSize="14" VerticalAlignment="Center" Opacity="0.7"/>
                        <ItemsControl x:Name="TagChipsRepeater">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Button x:Name="ДобавитьTagBtn" Click="Вкл.ДобавитьTagClick"
                                Назадground="{ThemeResource ChipBrush}"
                                BorderBrush="{ThemeResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12"
                                Padding="10,3"
                                VerticalAlignment="Center">
                            <TextBlock Text="+ Добавить тег" FontSize="11"
                                       Foreground="{ThemeResource MutedBrush}"/>
                        </Button>
                        <AutoSuggestBox x:Name="ДобавитьTagBox" Visibility="Collapsed"
                                        PlaceholderText="Название тега (Enter — добавить)"
                                        Width="180"
                                        QuerySubmitted="Вкл.ДобавитьTagSubmitted"
                                        TextChanged="Вкл.ДобавитьTagTextChanged"
                                        LostFocus="Вкл.ДобавитьTagBlur"
                                        VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- v4.2.0 (#14): file info, plot, notes and details, one under another.
                     In a wide window the code moves them beside the poster. -->
                <StackPanel x:Name="BodyStack">
                    <!-- File info panel (v2.2.2) — sits right under the action row -->
                    <Border x:Name="FileInfoPanel" Visibility="Collapsed"
                            Margin="0,12,0,0" Padding="12,8"
                            Назадground="{ThemeResource CardBrush}"
                            BorderBrush="{ThemeResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <controls:WrapPanel HorizontalSpacing="24" VerticalSpacing="8">
                            <StackPanel x:Name="FiПродолжительностьBlock" Visibility="Collapsed">
                                <TextBlock Text="ПРОДОЛЖИТЕЛЬНОСТЬ" FontSize="9" FontWeight="SemiBold"
                                           CharacterSpacing="150" Opacity="0.65"
                                           Foreground="{ThemeResource MutedBrush}"/>
                                <TextBlock x:Name="FiПродолжительность" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextBrush}"/>
                            </StackPanel>
                            <StackPanel x:Name="FiReleaseBlock" Visibility="Collapsed">
                                <TextBlock Text="ДАТА ВЫХОДА" FontSize="9" FontWeight="SemiBold"
                                           CharacterSpacing="150" Opacity="0.65"
                                           Foreground="{ThemeResource MutedBrush}"/>
                                <TextBlock x:Name="FiRelease" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextBrush}"/>
                            </StackPanel>
                            <StackPanel x:Name="FiMpaaBlock" Visibility="Collapsed">
                                <TextBlock Text="РЕЙТИНГ" FontSize="9" FontWeight="SemiBold"
                                           CharacterSpacing="150" Opacity="0.65"
                                           Foreground="{ThemeResource MutedBrush}"/>
                                <TextBlock x:Name="FiMpaa" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextBrush}"/>
                            </StackPanel>
                            <StackPanel x:Name="FiСтранаBlock" Visibility="Collapsed">
                                <TextBlock Text="СТРАНА" FontSize="9" FontWeight="SemiBold"
                                           CharacterSpacing="150" Opacity="0.65"
                                           Foreground="{ThemeResource MutedBrush}"/>
                                <TextBlock x:Name="FiСтрана" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextBrush}"/>
                            </StackPanel>
                            <StackPanel x:Name="FiSizeBlock" Visibility="Collapsed">
                                <TextBlock Text="РАЗМЕР ФАЙЛА" FontSize="9" FontWeight="SemiBold"
                                           CharacterSpacing="150" Opacity="0.65"
                                           Foreground="{ThemeResource MutedBrush}"/>
                                <TextBlock x:Name="FiSize" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextBrush}"/>
                            </StackPanel>
                            <StackPanel x:Name="FiDurBlock" Visibility="Collapsed">
                                <TextBlock Text="DURATION" FontSize="9" FontWeight="SemiBold"
                                           CharacterSpacing="150" Opacity="0.65"
                                           Foreground="{ThemeResource MutedBrush}"/>
                                <TextBlock x:Name="FiDur" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextBrush}"/>
                            </StackPanel>
                            <StackPanel x:Name="FiContainerBlock" Visibility="Collapsed">
                                <TextBlock Text="КОНТЕЙНЕР" FontSize="9" FontWeight="SemiBold"
                                           CharacterSpacing="150" Opacity="0.65"
                                           Foreground="{ThemeResource MutedBrush}"/>
                                <TextBlock x:Name="FiContainer" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextBrush}"/>
                            </StackPanel>
                            <StackPanel x:Name="FiLangBlock" Visibility="Collapsed">
                                <TextBlock Text="АУДИО" FontSize="9" FontWeight="SemiBold"
                                           CharacterSpacing="150" Opacity="0.65"
                                           Foreground="{ThemeResource MutedBrush}"/>
                                <TextBlock x:Name="FiLangs" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextBrush}"/>
                            </StackPanel>
                            <StackPanel x:Name="FiSubsBlock" Visibility="Collapsed">
                                <TextBlock Text="СУБТИТРЫ" FontSize="9" FontWeight="SemiBold"
                                           CharacterSpacing="150" Opacity="0.65"
                                           Foreground="{ThemeResource MutedBrush}"/>
                                <TextBlock x:Name="FiSubs" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextBrush}"/>
                            </StackPanel>
                        </controls:WrapPanel>
                    </Border>

                    <!-- Plot — with section header + capped width for readability -->
                    <StackPanel x:Name="PlotBlock">
                        <Border x:Name="PlotDivider" Visibility="Collapsed"
                                Height="1" Назадground="{ThemeResource BorderBrush}"
                                Margin="0,24,0,0" Opacity="0.5"/>
                        <StackPanel x:Name="PlotSection" Visibility="Collapsed" Margin="0,20,0,0" Spacing="8">
                            <TextBlock Text="СЮЖЕТ" FontSize="10" FontWeight="SemiBold"
                                       CharacterSpacing="150" Opacity="0.65"
                                       Foreground="{ThemeResource MutedBrush}"/>
                            <TextBlock x:Name="PlotText" FontSize="14" Foreground="{ThemeResource TextBrush}"
                                       TextWrapping="Wrap" LineHeight="22" MaxWidth="780"
                                       HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Заметки (v1.9) -->
                    <Border x:Name="ЗаметкиCard" Margin="0,20,0,0" Padding="14,12"
                            Назадground="{ThemeResource CardBrush}"
                            BorderBrush="{ThemeResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📝 Заметки"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextBrush}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button x:Name="NoteДобавитьBtn" Click="Вкл.NoteИзменитьStart"
                                            Content="+ Добавить заметку" Visibility="Collapsed"
                                            Назадground="Transparent"
                                            Foreground="{ThemeResource MutedBrush}"
                                            BorderBrush="{ThemeResource BorderBrush}"
                                            CornerRadius="6" Padding="10,4" FontSize="12"/>
                                    <Button x:Name="NoteИзменитьBtn" Click="Вкл.NoteИзменитьStart"
                                            Content="Изменить" Visibility="Collapsed"
                                            Назадground="Transparent"
                                            Foreground="{ThemeResource MutedBrush}"
                                            BorderBrush="{ThemeResource BorderBrush}"
                                            CornerRadius="6" Padding="10,4" FontSize="12"/>
                                    <Button x:Name="NoteСохранитьBtn" Click="Вкл.NoteСохранить"
                                            Content="Сохранить" Visibility="Collapsed"
                                            Назадground="{StaticResource BrandPurpleBrush}"
                                            Foreground="#FFFFFF"
                                            BorderThickness="0"
                                            CornerRadius="6" Padding="10,4" FontSize="12"/>
                                    <Button x:Name="NoteОтменаBtn" Click="Вкл.NoteОтмена"
                                            Content="Отмена" Visibility="Collapsed"
                                            Назадground="Transparent"
                                            Foreground="{ThemeResource MutedBrush}"
                                            BorderBrush="{ThemeResource BorderBrush}"
                                            CornerRadius="6" Padding="10,4" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="NoteText" Visibility="Collapsed"
                                       FontSize="13" Foreground="{ThemeResource TextBrush}"
                                       TextWrapping="Wrap" LineHeight="20"/>
                            <TextBox x:Name="NoteИзменитьor" Visibility="Collapsed"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="100" MaxHeight="240"
                                     PlaceholderText="Что вы думаете об этом фильме?"
                                     FontSize="13"/>
                            <TextBlock x:Name="NoteНе в сетиHint" Visibility="Collapsed"
                                       Text="Диск недоступен — заметка сохранена локально и будет синхронизирована с папкой фильма после подключения."
                                       FontSize="11" Foreground="{ThemeResource MutedBrush}"
                                       FontStyle="Italic" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="FieldsBlock">
                        <!-- Subtle section divider before fields grid -->
                        <Border x:Name="FieldsDivider" Height="1" Назадground="{ThemeResource BorderBrush}"
                                Margin="0,24,0,0" Opacity="0.5"/>

                        <!-- Fields grid -->
                        <Grid x:Name="FieldsGrid" Margin="0,20,0,0" SizeChanged="Вкл.FieldsGridSizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Column="0" x:Name="ЖанрыField" Visibility="Collapsed" Spacing="4">
                                <TextBlock Text="Жанры" FontSize="11" Foreground="{ThemeResource MutedBrush}"/>
                                <controls:WrapPanel x:Name="GenreLinks" HorizontalSpacing="4" VerticalSpacing="2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" x:Name="РежиссёрField" Visibility="Collapsed" Spacing="4">
                                <TextBlock Text="Режиссёр" FontSize="11" Foreground="{ThemeResource MutedBrush}"/>
                                <controls:WrapPanel x:Name="РежиссёрLinks" HorizontalSpacing="4" VerticalSpacing="2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock x:Name="СтудияLabel" Visibility="Collapsed"
                                           Text="Студия" FontSize="11" Foreground="{ThemeResource MutedBrush}"/>
                                <TextBlock x:Name="СтудияText" Visibility="Collapsed"
                                           FontSize="13" Foreground="{ThemeResource TextBrush}"
                                           TextWrapping="Wrap"/>
                                <HyperlinkButton x:Name="СтудияLink" Visibility="Collapsed"
                                                 Padding="0" FontSize="13"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- Divider above Актёры -->
                <Border x:Name="АктёрыDivider" Visibility="Collapsed"
                        Height="1" Назадground="{ThemeResource BorderBrush}"
                        Margin="0,24,0,0" Opacity="0.5"/>
                <!-- Актёры — wraps to multiple rows, no side-scroll -->
                <StackPanel x:Name="АктёрыSection" Margin="0,20,0,0" Visibility="Collapsed">
                    <TextBlock Text="Актёры" FontSize="16" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextBrush}" Margin="0,0,0,10"/>
                        <ItemsRepeater x:Name="АктёрыRepeater">
                            <ItemsRepeater.Layout>
                                <!-- Portrait 2:3 cards: image 140×210 + name/role. The height is
                                     set in code to fit the longest name and role (v3.8.0). -->
                                <UniformGridLayout x:Name="АктёрыGridLayout" MinItemWidth="150" MinItemHeight="280"
                                                   MinColumnSpacing="14" MinRowSpacing="18"
                                                   ItemsStretch="None"
                                                   Orientation="Horizontal"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:Actor">
                                    <Button Width="140"
                                            Назадground="Transparent"
                                            BorderThickness="0" Padding="0"
                                            CornerRadius="10"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalAlignment="Top"
                                            Tag="{x:Bind Name}"
                                            Click="Вкл.ActorClick">
                                        <StackPanel Spacing="8" HorizontalAlignment="Stretch">
                                            <!-- 2:3 portrait headshot (140 × 210, rounded) -->
                                            <Border Width="140" Height="210"
                                                    CornerRadius="10"
                                                    Назадground="{ThemeResource PlaceholderBgBrush}"
                                                    BorderBrush="{ThemeResource BorderBrush}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <!-- Initials sit behind the image and show
                                                         through when the thumbnail is missing
                                                         or fails to load. -->
                                                    <TextBlock Text="{x:Bind Initials}"
                                                               FontSize="34" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource MutedBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    <Image Stretch="UniformToFill"
                                                           Source="{x:Bind ThumbBitmap, Mode=Вкл.eWay}"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{x:Bind Name}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextBrush}"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextWrapping="WrapWholeWords"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="2"/>
                                            <TextBlock Text="{x:Bind Role, TargetNullValue=''}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource MutedBrush}"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextWrapping="WrapWholeWords"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="2"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Sticky action bar (v2.3) — appears once you scroll past the hero -->
        <Border x:Name="StickyBar" Visibility="Collapsed"
                Назадground="{ThemeResource SidebarBrush}"
                BorderBrush="{ThemeResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Height="52" VerticalAlignment="Top" Opacity="0.96">
            <Grid Padding="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StickyНазвание" Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="StickyВоспроизвестиBtn" Click="Вкл.Воспроизвести"
                            Назадground="#A78BFA" Foreground="White"
                            BorderThickness="0" CornerRadius="6" Padding="14,5">
                        <TextBlock Text="▶ Воспроизвести"/>
                    </Button>
                    <Button Click="Вкл.StickyЗакрыть"
                            Назадground="Transparent"
                            Foreground="{ThemeResource MutedBrush}"
                            BorderThickness="0" CornerRadius="6" Padding="10,5"
                            Content="✕"/>
                </StackPanel>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
