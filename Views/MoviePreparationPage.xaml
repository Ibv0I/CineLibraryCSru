<Page
    x:Class="CineLibraryCS.Views.MoviePreparationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid Padding="28" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Spacing="5">
            <TextBlock Text="Подготовка медиатеки" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}"/>
            <TextBlock Text="Найдите папки с видео без movie.nfo и вручную сопоставьте каждый фильм с записью TMDb. Можно сохранять фильмы по одному или подготовить все фильмы с выбранными совпадениями одной операцией." TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}"/>
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="RootPathBox" PlaceholderText="Выберите папку с фильмами" IsReadOnly="True" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Выбрать папку…" Click="OnChooseFolderClick"/>
            <Button Grid.Column="2" Content="Сохранить выбранные фильмы" Click="OnSaveAllPreparedMoviesClick" Style="{ThemeResource AccentButtonStyle}"/>
        </Grid>
        <CheckBox x:Name="DownloadActorPhotosCheckBox" Grid.Row="2" Content="Скачивать фотографии актёров в папку .actors" IsChecked="True"/>
        <TextBlock x:Name="StatusText" Grid.Row="3" Text="Выберите папку с фильмами — поиск начнётся автоматически." TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}"/>
        <ListView x:Name="FoldersList" Grid.Row="4" SelectionMode="None" IsItemClickEnabled="False">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="14" Margin="0,0,0,8" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource InputBorderBrush}" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FolderName}" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}"/>
                                <TextBlock Text="{Binding FolderPath}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}"/>
                                <TextBlock Text="{Binding VideoSummary}" FontSize="12" Foreground="{ThemeResource MutedBrush}"/>
                                <TextBlock Text="{Binding MatchSummary}" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="Выбрать фильм в TMDb" Click="OnPickMovieClick" Tag="{Binding}"/><Button Content="Сохранить файлы" Click="OnSavePreparedMovieClick" Tag="{Binding}" Style="{ThemeResource AccentButtonStyle}"/></StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
