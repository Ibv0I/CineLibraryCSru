<Page
    x:Class="CineLibraryCS.Views.MoviePreparationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid Padding="28" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Spacing="5">
            <TextBlock Text="Подготовка медиатеки" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}"/>
            <TextBlock Text="Добавляйте несколько папок с фильмами. Можно вручную выбрать совпадения TMDb или автоматически подготовить фильмы по первому результату поиска." TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="Добавить папку…" Click="OnChooseFolderClick"/>
            <Button Content="Папки исключения…" Click="OnManageExclusionsClick"/>
        </StackPanel>
        <ListView x:Name="RootFoldersList" Grid.Row="2" MaxHeight="100" SelectionMode="None" IsItemClickEnabled="False" BorderThickness="1" BorderBrush="{ThemeResource InputBorderBrush}">
            <ListView.ItemTemplate><DataTemplate>
                <Grid ColumnSpacing="8" Padding="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Path}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{ThemeResource TextBrush}"/>
                    <Button Grid.Column="1" Content="✕" Tag="{Binding Path}" Click="OnRemoveRootClick" ToolTipService.ToolTip="Удалить папку из списка" Padding="8,2"/>
                </Grid>
            </DataTemplate></ListView.ItemTemplate>
        </ListView>
        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Автоподготовка всех фильмов" Click="OnAutoPrepareAllClick" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Left"/>
            <Button Grid.Column="1" Content="Добавить в медиатеку" Click="OnSaveAllPreparedMoviesClick"/>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="4" Text="Добавьте одну или несколько папок. Поиск начнётся автоматически." TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}"/>
        <ListView x:Name="FoldersList" Grid.Row="5" SelectionMode="None" IsItemClickEnabled="False">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="14" Margin="0,0,0,8" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource InputBorderBrush}" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FolderName}" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}"/>
                                <TextBlock Text="{Binding FolderPath}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}"/>
                                <TextBlock Text="{Binding VideoSummary}" FontSize="12" Foreground="{ThemeResource MutedBrush}"/>
                                <TextBlock Text="{Binding MatchSummary}" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextBrush}"/>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="{Binding PosterGlyph}" FontSize="13" Foreground="#399BFF"/><TextBlock Text="Постер" FontSize="12" Foreground="{ThemeResource MutedBrush}"/>
                                    <TextBlock Text="{Binding FanartGlyph}" FontSize="13" Foreground="#399BFF" Margin="7,0,0,0"/><TextBlock Text="Баннер" FontSize="12" Foreground="{ThemeResource MutedBrush}"/>
                                    <TextBlock Text="{Binding NfoGlyph}" FontSize="13" Foreground="#399BFF" Margin="7,0,0,0"/><TextBlock Text="NFO" FontSize="12" Foreground="{ThemeResource MutedBrush}"/><TextBlock Text="{Binding LibraryGlyph}" FontSize="13" Foreground="#399BFF" Margin="12,0,0,0"/><TextBlock Text="{Binding LibraryStatusText}" FontSize="12" Foreground="{ThemeResource MutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="Выбрать фильм в TMDb" Click="OnPickMovieClick" Tag="{Binding}"/><Button Content="Сохранить файлы" Click="OnSavePreparedMovieClick" Tag="{Binding}" Style="{ThemeResource AccentButtonStyle}"/></StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
