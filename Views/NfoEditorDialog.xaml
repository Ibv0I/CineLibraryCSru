<Window
    x:Class="CineLibraryCS.Views.NfoEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Редактор NFO">
    <Grid x:Name="RootGrid" RequestedTheme="Dark" Background="#121214" Padding="14" RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TabView Grid.Row="0" x:Name="EditorTabs" IsAddTabButtonVisible="False" TabWidthMode="Equal">
            <TabViewItem Header="Метаданные">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,12,8">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="TitleBox" Header="Название" Grid.Column="0"/>
                            <TextBox x:Name="OriginalTitleBox" Header="Оригинальное название" Grid.Column="1"/>
                        </Grid>
                        <TextBox x:Name="TaglineBox" Header="Слоган"/>
                        <TextBox x:Name="PlotBox" Header="Сюжет" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="160"/>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="YearBox" Header="Год" Grid.Column="0" InputScope="Number" TextChanged="OnYearChanged"/>
                            <TextBox x:Name="PremieredBox" Header="Дата выхода (ДД-ММ-ГГГГ)" Grid.Column="1" TextChanged="OnDateChanged"/>
                            <TextBox x:Name="RuntimeBox" Header="Продолжительность, мин" Grid.Column="2" InputScope="Number"/>
                        </Grid>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="StudiosBox" Header="Студии (по одной на строку)" Grid.Column="0" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"/>
                            <TextBox x:Name="CountriesBox" Header="Страны (по одной на строку)" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"/>
                        </Grid>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="CertificationBox" Header="Сертификация / возрастной рейтинг" Grid.Column="0" IsEditable="False" />
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBox x:Name="GenresBox" Header="Жанры (через запятую)" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="64" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="＋ Добавить жанр" Click="OnAddGenre" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="12" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="5">
                                <TextBlock Text="Идентификаторы" Foreground="{ThemeResource TextBrush}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Источник" Grid.Column="0" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                                    <TextBlock Text="Идентификатор" Grid.Column="1" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                                </Grid>
                                <ListView x:Name="IdentifiersList" MinHeight="108" Height="108" SelectionMode="Single" Padding="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="OnIdentifierSelectionChanged">
                                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style></ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate><DataTemplate><Grid x:Name="IdentifierRowRoot" Height="28" ColumnSpacing="0"><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="IdentifierSelectionIndicator" Grid.Column="0" Background="#3987FF" CornerRadius="2" Margin="0,4,0,4" Opacity="0"/><Border x:Name="IdentifierRowBackground" Grid.Column="1" Background="Transparent" CornerRadius="6" Padding="2,0"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Source}" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Identifier}" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid></Border></Grid></DataTemplate></ListView.ItemTemplate>
                                </ListView>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="＋ Добавить" Click="OnAddIdentifier" />
                                    <Button Content="✎ Изменить" Click="OnEditIdentifier" />
                                    <Button Content="－ Удалить" Click="OnRemoveIdentifier" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Text="Рейтинги" Foreground="{ThemeResource TextBrush}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Источник" Grid.Column="0" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                                    <TextBlock Text="Рейтинг" Grid.Column="1" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                                    <TextBlock Text="Количество голосов" Grid.Column="2" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                                </Grid>
                                <ListView x:Name="RatingsList" MinHeight="108" Height="108" SelectionMode="Single" Padding="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="OnRatingSelectionChanged">
                                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style></ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate><DataTemplate><Grid x:Name="RatingRowRoot" Height="28" ColumnSpacing="0"><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="RatingSelectionIndicator" Grid.Column="0" Background="#3987FF" CornerRadius="2" Margin="0,4,0,4" Opacity="0"/><Border x:Name="RatingRowBackground" Grid.Column="1" Background="Transparent" CornerRadius="6" Padding="2,0"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Source}" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Value}" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Votes}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid></Border></Grid></DataTemplate></ListView.ItemTemplate>
                                </ListView>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="＋ Добавить" Click="OnAddRating" />
                                    <Button Content="✎ Изменить" Click="OnEditRating" />
                                    <Button Content="－ Удалить" Click="OnRemoveRating" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="Техническая информация">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,12,8">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="VideoCodecBox" Header="Видеокодек" Grid.Column="0"/>
                            <TextBox x:Name="VideoBitrateBox" Header="Битрейт видео (бит/с)" Grid.Column="1"/>
                        </Grid>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="WidthBox" Header="Ширина видео" Grid.Column="0"/>
                            <TextBox x:Name="HeightBox" Header="Высота видео" Grid.Column="1"/>
                            <TextBox x:Name="FrameRateBox" Header="Частота кадров" Grid.Column="2"/>
                        </Grid>
                        <TextBox x:Name="HdrBox" Header="Формат HDR"/>
                        <TextBlock Text="Звуковые дорожки" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}"/>
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Кодек" Grid.Column="0" TextAlignment="Center"/><TextBlock Text="Язык" Grid.Column="1" TextAlignment="Center"/><TextBlock Text="Каналы" Grid.Column="2" TextAlignment="Center"/><TextBlock Text="Битрейт" Grid.Column="3" TextAlignment="Center"/><TextBlock Text="Частота" Grid.Column="4" TextAlignment="Center"/><TextBlock Text="Название" Grid.Column="5" TextAlignment="Center"/>
                        </Grid>
                        <ListView x:Name="AudioTracksList" SelectionMode="Single" Padding="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Height" Value="25"/><Setter Property="MinHeight" Value="25"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,1"/><Setter Property="CornerRadius" Value="4"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
                            <ListView.ItemTemplate><DataTemplate><Grid Height="23" ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Values[0]}" Grid.Column="0" TextAlignment="Center" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Text="{Binding Values[1]}" Grid.Column="1" TextAlignment="Center" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Text="{Binding Values[2]}" Grid.Column="2" TextAlignment="Center" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Text="{Binding Values[3]}" Grid.Column="3" TextAlignment="Center" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Text="{Binding Values[4]}" Grid.Column="4" TextAlignment="Center" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Text="{Binding Values[5]}" Grid.Column="5" TextAlignment="Center" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Grid></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Spacing="6"><Button Content="＋ Добавить" Click="OnAddAudioTrack"/><Button Content="✎ Изменить" Click="OnEditAudioTrack"/><Button Content="－ Удалить" Click="OnRemoveAudioTrack"/></StackPanel>
                        <TextBlock Text="Субтитры" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}"/>
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Язык" Grid.Column="0" TextAlignment="Center"/><TextBlock Text="Формат" Grid.Column="1" TextAlignment="Center"/><TextBlock Text="Название" Grid.Column="2" TextAlignment="Center"/><TextBlock Text="По умолчанию" Grid.Column="3" TextAlignment="Center"/><TextBlock Text="Принудит." Grid.Column="4" TextAlignment="Center"/>
                        </Grid>
                        <ListView x:Name="SubtitlesList" SelectionMode="Single" Padding="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Height" Value="25"/><Setter Property="MinHeight" Value="25"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,1"/><Setter Property="CornerRadius" Value="4"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
                            <ListView.ItemTemplate><DataTemplate><Grid Height="23" ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Values[0]}" Grid.Column="0" TextAlignment="Center" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Text="{Binding Values[1]}" Grid.Column="1" TextAlignment="Center" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Text="{Binding Values[2]}" Grid.Column="2" TextAlignment="Center" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Text="{Binding Values[3]}" Grid.Column="3" TextAlignment="Center" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Text="{Binding Values[4]}" Grid.Column="4" TextAlignment="Center" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Grid></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Spacing="6"><Button Content="＋ Добавить" Click="OnAddSubtitle"/><Button Content="✎ Изменить" Click="OnEditSubtitle"/><Button Content="－ Удалить" Click="OnRemoveSubtitle"/></StackPanel>
                        <TextBlock Text="Формат строк указан над полями. Неизвестные XML-поля сохраняются при записи." FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="Отмена" MinWidth="110" Click="OnCancelClick"/>
            <Button Content="Сохранить" MinWidth="110" Style="{ThemeResource AccentButtonStyle}" Click="OnSaveClick"/>
        </StackPanel>
    </Grid>
</Window>
