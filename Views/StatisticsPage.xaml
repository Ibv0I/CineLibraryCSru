<Page
    x:Class="CineМедиатекаCS.Views.СтатистикаPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CineМедиатекаCS.Models"
    Назадground="{ThemeResource BgBrush}">

    <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto" Padding="28,8,28,40"
                  SizeChanged="Вкл.PageScrollerSizeChanged">
        <StackPanel x:Name="PageStack" MaxWidth="1100" HorizontalAlignment="Stretch" Spacing="24">

            <!-- Page header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Статистика"
                           FontSize="24" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextBrush}"/>
                <TextBlock x:Name="PageНазвание" Text="Ваша коллекция одним взглядом"
                           FontSize="13"
                           Foreground="{ThemeResource MutedBrush}"/>
            </StackPanel>

            <!-- ── Top row: summary tiles ──────────────────────────────────── -->
            <Grid ColumnSpacing="14" RowSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatTileStyle}">
                    <StackPanel>
                        <TextBlock Text="🎬" FontSize="22"/>
                        <TextBlock x:Name="TileTotalФильмы" Text="0"
                                   FontSize="36" FontWeight="Bold"
                                   CharacterSpacing="-25"
                                   Foreground="{ThemeResource TextBrush}" Margin="0,4,0,0"/>
                        <TextBlock Text="Всего фильмов" FontSize="12"
                                   Foreground="{ThemeResource MutedBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource StatTileStyle}">
                    <StackPanel>
                        <TextBlock Text="⏱️" FontSize="22"/>
                        <TextBlock x:Name="TileTotalПродолжительность" Text="—"
                                   FontSize="36" FontWeight="Bold"
                                   CharacterSpacing="-25"
                                   Foreground="{ThemeResource TextBrush}" Margin="0,4,0,0"/>
                        <TextBlock Text="Общая продолжительность" FontSize="12"
                                   Foreground="{ThemeResource MutedBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource StatTileStyle}">
                    <StackPanel>
                        <TextBlock Text="⭐" FontSize="22"/>
                        <TextBlock x:Name="TileAvgРейтинг" Text="—"
                                   FontSize="36" FontWeight="Bold"
                                   CharacterSpacing="-25"
                                   Foreground="#FACC15" Margin="0,4,0,0"/>
                        <TextBlock Text="Средний рейтинг" FontSize="12"
                                   Foreground="{ThemeResource MutedBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource StatTileStyle}">
                    <StackPanel>
                        <TextBlock Text="💾" FontSize="22"/>
                        <TextBlock x:Name="TileTotalДиски" Text="0"
                                   FontSize="36" FontWeight="Bold"
                                   CharacterSpacing="-25"
                                   Foreground="{ThemeResource TextBrush}" Margin="0,4,0,0"/>
                        <TextBlock Text="Отслеживаемые диски" FontSize="12"
                                   Foreground="{ThemeResource MutedBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- v3.3 — Просмотрено и удалено tally -->
            <TextBlock x:Name="ArchivedLine" Visibility="Collapsed"
                       FontSize="12" Foreground="{ThemeResource MutedBrush}"
                       Margin="2,0,0,0"/>

            <!-- ── Watch progress ──────────────────────────────────────────── -->
            <Border Style="{StaticResource StatPanelStyle}">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="✓ Watch progress" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextBrush}"/>
                        <TextBlock Grid.Column="1" x:Name="WatchProgressText" Text="0 / 0 (0%)"
                                   FontSize="13" Foreground="{ThemeResource MutedBrush}"/>
                    </Grid>
                    <ProgressBar x:Name="WatchProgressBar" Minimum="0" Maximum="100" Value="0"
                                 Height="10" Foreground="#22C55E"/>
                    <TextBlock x:Name="Список просмотраCountText" Text=""
                               FontSize="12" Foreground="{ThemeResource MutedBrush}"/>
                </StackPanel>
            </Border>

            <!-- ── TV Shows (v2.8.2) — only shown when shows exist ─────────── -->
            <Border x:Name="TvSection" Style="{StaticResource StatPanelStyle}" Visibility="Collapsed">
                <StackPanel Spacing="14">
                    <TextBlock Text="📺 TV Shows" FontSize="14" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextBrush}"/>
                    <!-- TV summary tiles -->
                    <Grid ColumnSpacing="14" RowSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource StatTileStyle}">
                            <StackPanel>
                                <TextBlock Text="📺" FontSize="22"/>
                                <TextBlock x:Name="TileTotalShows" Text="0"
                                           FontSize="36" FontWeight="Bold" CharacterSpacing="-25"
                                           Foreground="{ThemeResource TextBrush}" Margin="0,4,0,0"/>
                                <TextBlock Text="Сериалы" FontSize="12"
                                           Foreground="{ThemeResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource StatTileStyle}">
                            <StackPanel>
                                <TextBlock Text="🎞️" FontSize="22"/>
                                <TextBlock x:Name="TileTotalЭпизоды" Text="0"
                                           FontSize="36" FontWeight="Bold" CharacterSpacing="-25"
                                           Foreground="{ThemeResource TextBrush}" Margin="0,4,0,0"/>
                                <TextBlock Text="Эпизоды" FontSize="12"
                                           Foreground="{ThemeResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource StatTileStyle}">
                            <StackPanel>
                                <TextBlock Text="⏱️" FontSize="22"/>
                                <TextBlock x:Name="TileTvПродолжительность" Text="—"
                                           FontSize="36" FontWeight="Bold" CharacterSpacing="-25"
                                           Foreground="{ThemeResource TextBrush}" Margin="0,4,0,0"/>
                                <TextBlock Text="Продолжительность эпизода" FontSize="12"
                                           Foreground="{ThemeResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource StatTileStyle}">
                            <StackPanel>
                                <TextBlock Text="⭐" FontSize="22"/>
                                <TextBlock x:Name="TileTvAvgРейтинг" Text="—"
                                           FontSize="36" FontWeight="Bold" CharacterSpacing="-25"
                                           Foreground="#FACC15" Margin="0,4,0,0"/>
                                <TextBlock Text="Средний рейтинг сериалов" FontSize="12"
                                           Foreground="{ThemeResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <!-- TV watch progress -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="✓ Эпизоды watched" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextBrush}"/>
                        <TextBlock Grid.Column="1" x:Name="TvWatchProgressText" Text="0 / 0 (0%)"
                                   FontSize="13" Foreground="{ThemeResource MutedBrush}"/>
                    </Grid>
                    <ProgressBar x:Name="TvWatchProgressBar" Minimum="0" Maximum="100" Value="0"
                                 Height="10" Foreground="#22C55E"/>
                </StackPanel>
            </Border>

            <!-- ── Two-column: Decades + Top genres ────────────────────────── -->
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatPanelStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="📅 Фильмы by decade" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextBrush}"/>
                        <StackPanel x:Name="DecadesPanel" Spacing="6"/>
                        <TextBlock x:Name="DecadesEmpty" Text="Данных о годах пока нет."
                                   FontSize="12" Foreground="{ThemeResource MutedBrush}"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource StatPanelStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="🏷 Top genres" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextBrush}"/>
                        <StackPanel x:Name="ЖанрыPanel" Spacing="6"/>
                        <TextBlock x:Name="ЖанрыEmpty" Text="Жанры пока не указаны."
                                   FontSize="12" Foreground="{ThemeResource MutedBrush}"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Two-column: Режиссёрs + Actors ──────────────────────────── -->
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatPanelStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="🎥 Top directors" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextBrush}"/>
                        <StackPanel x:Name="РежиссёрsPanel" Spacing="6"/>
                        <TextBlock x:Name="РежиссёрsEmpty" Text="Данные о режиссёрах пока отсутствуют."
                                   FontSize="12" Foreground="{ThemeResource MutedBrush}"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource StatPanelStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="🎭 Top actors" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextBrush}"/>
                        <StackPanel x:Name="ActorsPanel" Spacing="6"/>
                        <TextBlock x:Name="ActorsEmpty" Text="Данные об актёрах пока отсутствуют."
                                   FontSize="12" Foreground="{ThemeResource MutedBrush}"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="MissingHint" Text=""
                       FontSize="12" Foreground="#EF4444" Margin="0,0,0,8"
                       Visibility="Collapsed"/>

        </StackPanel>
    </ScrollViewer>
</Page>
