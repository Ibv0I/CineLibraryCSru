<Window
    x:Class="CineLibraryCS.Views.TmdbPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CineLibraryCS.Views"
    Title="Выбор фильма">

    <Grid x:Name="RootGrid" Background="Transparent" RequestedTheme="Dark" Padding="0">
        <Border Background="{ThemeResource BgBrush}" CornerRadius="12" BorderBrush="{ThemeResource InputBorderBrush}" BorderThickness="1" Padding="22">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="HintText" Grid.Row="0"
                           Text="Выберите источник и правильное совпадение фильма для папки."
                           TextWrapping="Wrap" FontSize="13"
                           Foreground="{ThemeResource TextBrush}" />
                <ComboBox x:Name="SourceBox" Grid.Row="1" Header="Источник фильмов" MinWidth="220" HorizontalAlignment="Left" SelectedIndex="0">
                    <ComboBoxItem Content="TMDb" />
                    <ComboBoxItem Content="КиноПоиск" />
                </ComboBox>
                <Grid Grid.Row="2" ColumnSpacing="14" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="250" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TitleBox" Grid.Column="0" PlaceholderText="Название фильма…"
                             KeyDown="OnTitleKeyDown" MinWidth="0" HorizontalAlignment="Stretch" />
                    <TextBox x:Name="YearBox" Grid.Column="1" PlaceholderText="Год"
                             MaxLength="4" InputScope="Number" HorizontalAlignment="Stretch" />
                    <Button x:Name="SearchBtn" Grid.Column="2" Content="Найти" Click="OnSearch"
                            HorizontalAlignment="Stretch" Style="{ThemeResource AccentButtonStyle}" />
                </Grid>
                <Grid Grid.Row="3" ColumnSpacing="8" MinHeight="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Grid.Column="1" FontSize="13"
                               Foreground="{ThemeResource TextBrush}" VerticalAlignment="Center"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </Grid>
                <ListView x:Name="ResultsList" Grid.Row="4" MinHeight="300"
                          SelectionMode="Single" SelectionChanged="OnResultSelected"
                          Background="{ThemeResource ControlFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource InputBorderBrush}" BorderThickness="1"
                          CornerRadius="8">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:TmdbResultItem">
                            <Grid ColumnSpacing="16" Padding="10,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="72" Height="108" CornerRadius="5"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <Image Source="{x:Bind Thumb}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                    <TextBlock Text="{x:Bind DisplayTitle}" FontSize="16" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextBrush}" />
                                    <TextBlock Text="{x:Bind SubLine}" FontSize="13" Foreground="{ThemeResource TextBrush}" />
                                    <TextBlock Text="{x:Bind Overview}" FontSize="13" Foreground="{ThemeResource TextBrush}"
                                               TextWrapping="Wrap" MaxLines="8" TextTrimming="None" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <Button x:Name="CancelBtn" Content="Отмена" Click="OnCancelClick" MinWidth="110" />
                    <Button x:Name="SelectBtn" Content="Выбрать фильм" Click="OnChooseClick" MinWidth="150"
                            IsEnabled="False" Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
