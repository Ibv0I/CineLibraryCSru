<ContentDialog
    x:Class="CineLibraryCS.Views.TmdbPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CineLibraryCS.Views"
    Title="Выбор фильма в TMDb"
    PrimaryButtonText="Выбрать фильм"
    CloseButtonText="Отмена"
    DefaultButton="Primary"
    RequestedTheme="Dark"
    Width="900"
    MaxWidth="900"
    IsPrimaryButtonEnabled="False">

    <Grid MinWidth="760" MinHeight="500" RowSpacing="12" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="HintText" Grid.Row="0"
                   Text="Выберите правильный фильм, чтобы сопоставить папку с записью TMDb."
                   TextWrapping="Wrap" FontSize="13"
                   Foreground="{ThemeResource TextBrush}" />
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TitleBox" Grid.Column="0" PlaceholderText="Название фильма…"
                     KeyDown="OnTitleKeyDown" MinWidth="300" />
            <TextBox x:Name="YearBox" Grid.Column="1" PlaceholderText="Год" Width="100"
                     MaxLength="4" InputScope="Number" />
            <Button x:Name="SearchBtn" Grid.Column="2" Content="Найти" Click="OnSearch"
                    MinWidth="92" Style="{ThemeResource AccentButtonStyle}" />
        </Grid>
        <Grid Grid.Row="2" ColumnSpacing="8" MinHeight="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20"
                          VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Grid.Column="1" FontSize="13"
                       Foreground="{ThemeResource TextBrush}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Visibility="Collapsed" />
        </Grid>
        <ListView x:Name="ResultsList" Grid.Row="3" MinHeight="340"
                  SelectionMode="Single" SelectionChanged="OnResultSelected"
                  Background="{ThemeResource ControlFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource InputBorderBrush}" BorderThickness="1"
                  CornerRadius="8">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:TmdbResultItem">
                    <Grid ColumnSpacing="14" Padding="8,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="66" Height="99" CornerRadius="4"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <Image Source="{x:Bind Thumb}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                            <TextBlock Text="{x:Bind DisplayTitle}" FontSize="16" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextBrush}" />
                            <TextBlock Text="{x:Bind SubLine}" FontSize="13"
                                       Foreground="{ThemeResource TextBrush}" />
                            <TextBlock Text="{x:Bind Overview}" FontSize="13"
                                       Foreground="{ThemeResource TextBrush}" TextWrapping="Wrap"
                                       MaxLines="3" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
