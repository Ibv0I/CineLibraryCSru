<Page
    x:Class="CineМедиатекаCS.Views.ПросмотреноGonePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CineМедиатекаCS.Views"
    xmlns:models="using:CineМедиатекаCS.Models"
    Назадground="{ThemeResource BgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Padding="24,8,24,12" Spacing="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Просмотрено и удалено" FontSize="24" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextBrush}"/>
                    <TextBlock Text="Фильмы, которые вы посмотрели и удалили — записи, заметки и история сохраняются, чтобы вы случайно не скачали фильм снова."
                               FontSize="12" Foreground="{ThemeResource MutedBrush}"
                               TextWrapping="Wrap" MaxWidth="640"/>
                </StackPanel>
                <TextBlock x:Name="CountText" Grid.Column="1" Text=""
                           FontSize="13" Foreground="{ThemeResource MutedBrush}"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Toolbar: search · sort · add · export -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <AutoSuggestBox x:Name="ПоискBox" Grid.Column="0"
                                PlaceholderText="Поиск записей…"
                                QueryIcon="Find" Height="36" CornerRadius="8"
                                MaxWidth="420" HorizontalAlignment="Left" MinWidth="240"
                                TextChanged="Вкл.ПоискChanged"
                                Назадground="{ThemeResource InputBgBrush}"
                                BorderBrush="{ThemeResource InputBorderBrush}"
                                Foreground="{ThemeResource TextBrush}"/>
                <ComboBox x:Name="SortCombo" Grid.Column="1"
                          SelectionChanged="Вкл.SortChanged" SelectedIndex="0"
                          Height="36" MinWidth="150" CornerRadius="8" VerticalAlignment="Center"
                          Назадground="{ThemeResource InputBgBrush}"
                          Foreground="{ThemeResource TextBrush}"
                          BorderBrush="{ThemeResource InputBorderBrush}">
                    <ComboBoxItem Tag="archived:desc" Content="Недавно удалённые"/>
                    <ComboBoxItem Tag="title:asc"     Content="Название ↑"/>
                    <ComboBoxItem Tag="title:desc"    Content="Название ↓"/>
                    <ComboBoxItem Tag="year:desc"     Content="Год ↓"/>
                    <ComboBoxItem Tag="rating:desc"   Content="Рейтинг ↓"/>
                </ComboBox>
                <Button x:Name="ДобавитьBtn" Grid.Column="2" Click="Вкл.ДобавитьПросмотреноMovie"
                        Height="36" CornerRadius="8" Padding="14,0" VerticalAlignment="Center"
                        Style="{ThemeResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Добавить фильм, который вы смотрели, но которого никогда не было в медиатеке">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14"
                                  FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                        <TextBlock Text="Добавить просмотренный фильм" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ЭкспортBtn" Grid.Column="3" Click="Вкл.ЭкспортCsv"
                        Height="36" CornerRadius="8" Padding="14,0" VerticalAlignment="Center"
                        Назадground="{ThemeResource InputBgBrush}"
                        Foreground="{ThemeResource TextBrush}"
                        BorderBrush="{ThemeResource InputBorderBrush}"
                        ToolTipService.ToolTip="Экспортировать список записей в CSV">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEDE1;" FontSize="14"
                                  FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                        <TextBlock Text="Экспорт" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Records grid -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsRepeater x:Name="RecordsRepeater" Margin="24,4,24,24">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="150" MinItemHeight="280"
                                           MinColumnSpacing="12" MinRowSpacing="12"
                                           ItemsStretch="Fill"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:MovieListItem">
                            <local:MovieCardControl Movie="{x:Bind}" ArchiveMode="True"/>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- Empty state -->
                <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Margin="0,80,0,24" Spacing="8">
                    <FontIcon Glyph="&#xE7B8;" FontSize="40"
                              FontСемья="Segoe Fluent Icons,Segoe MDL2 Assets"
                              Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Записей пока нет"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="When you watch a movie and delete it from your drive, right-click it in the library and choose “Send to Просмотрено и удалено”. Or use “Добавить просмотренный фильм” above for films you saw elsewhere — at the cinema, on a streaming service, a friend's copy. Either way, the poster, details, your notes and watch history stay here as a permanent record."
                               FontSize="12" Foreground="{ThemeResource MutedBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="460"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
