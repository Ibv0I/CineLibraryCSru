<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ THEME-AWARE SURFACE COLOURS ═══════════════════════════════════ -->
    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Dark">
            <!-- Content + cards are OPAQUE so the scrolling poster grid never
                 composites over the live Mica backdrop (fast). Only the
                 sidebar (small, fixed area) stays translucent for the Mica
                 accent. -->
            <SolidColorBrush x:Key="BgBrush"         Color="#0A0A0C"/>
            <SolidColorBrush x:Key="SidebarBrush"    Color="#990F0F18"/>
            <SolidColorBrush x:Key="SidebarGlassBrush" Color="#CC0F0F18"/>
            <SolidColorBrush x:Key="CardBrush"       Color="#14141F"/>
            <SolidColorBrush x:Key="CardHoverBrush"  Color="#1E1E2E"/>
            <SolidColorBrush x:Key="BorderBrush"     Color="#2A2A3A"/>
            <SolidColorBrush x:Key="TextBrush"       Color="#E8E8F0"/>
            <SolidColorBrush x:Key="MutedBrush"      Color="#6B7280"/>
            <!-- v3.9.0: sidebar icon colour per section, as in Aryan -->
            <SolidColorBrush x:Key="NavLibraryIconBrush"  Color="#3B82F6"/>
            <SolidColorBrush x:Key="NavDiscoverIconBrush" Color="#4CC9A4"/>
            <SolidColorBrush x:Key="NavBrowseIconBrush"   Color="#F5B83D"/>
            <SolidColorBrush x:Key="NavToolsIconBrush"    Color="#9CA3AF"/>
            <SolidColorBrush x:Key="InputBgBrush"    Color="#14141F"/>
            <SolidColorBrush x:Key="InputBorderBrush" Color="#2A2A3A"/>
            <SolidColorBrush x:Key="ChipBrush"       Color="#1E1E2E"/>
            <SolidColorBrush x:Key="HeroBgBrush"     Color="#990A0A1C"/>
            <LinearGradientBrush x:Key="HeroFadeBrush" StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.00" Color="#000A0A0C"/>
                            <GradientStop Offset="0.48" Color="#000A0A0C"/>
                            <GradientStop Offset="0.62" Color="#080A0A0C"/>
                            <GradientStop Offset="0.73" Color="#220A0A0C"/>
                            <GradientStop Offset="0.83" Color="#660A0A0C"/>
                            <GradientStop Offset="0.92" Color="#CC0A0A0C"/>
                            <GradientStop Offset="1.00" Color="#FF0A0A0C"/>
                        </LinearGradientBrush>
            <SolidColorBrush x:Key="OverlayBrush"    Color="#CC0A0A1C"/>
            <SolidColorBrush x:Key="PlaceholderBgBrush" Color="#172033"/>
            <!-- v2.6 — poster-placeholder gradient stops for depth -->
            <Color x:Key="PlaceholderTopColor">#1A2233</Color>
            <Color x:Key="PlaceholderBottomColor">#0B1220</Color>
            <SolidColorBrush x:Key="ToastBgBrush"    Color="#1E1E3A"/>
            <SolidColorBrush x:Key="SubtleBgBrush"   Color="#0A1A2A"/>
            <!-- Sidebar section header (orange-tinted) -->
            <SolidColorBrush x:Key="SectionHeaderBgBrush"      Color="#3A2410"/>
            <SolidColorBrush x:Key="SectionHeaderBorderBrush"  Color="#B45309"/>
            <SolidColorBrush x:Key="SectionHeaderHoverBgBrush" Color="#4F2F15"/>
            <SolidColorBrush x:Key="SectionHeaderTextBrush"    Color="#FBBF77"/>
            <!-- Nav item active / hover states (Dark). v2.5.2 — tinted with
                 the brand purple so hover feels like a soft glow rather than
                 a plain grey wash; active state stronger so the current
                 page is obvious at a glance. -->
            <SolidColorBrush x:Key="NavHoverBgBrush"            Color="#263B82F6"/>
            <SolidColorBrush x:Key="NavPressedBgBrush"          Color="#3D3B82F6"/>
            <SolidColorBrush x:Key="NavActiveBgBrush"           Color="#553B82F6"/>
            <SolidColorBrush x:Key="NavActiveHoverBgBrush"      Color="#663B82F6"/>
            <SolidColorBrush x:Key="NavHoverBorderBrush"        Color="#553B82F6"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!-- v2.6 — Light theme tightening: sidebar separates harder
                 from the main content, borders/muted text get slightly
                 stronger so cards don't dissolve into the page bg. -->
            <SolidColorBrush x:Key="BgBrush"         Color="#F6F6FA"/>
            <SolidColorBrush x:Key="SidebarBrush"    Color="#99E3E3EE"/>
            <SolidColorBrush x:Key="SidebarGlassBrush" Color="#CCE3E3EE"/>
            <SolidColorBrush x:Key="CardBrush"       Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CardHoverBrush"  Color="#E7EFFB"/>
            <SolidColorBrush x:Key="BorderBrush"     Color="#C6C6DC"/>
            <SolidColorBrush x:Key="TextBrush"       Color="#15152A"/>
            <SolidColorBrush x:Key="MutedBrush"      Color="#5F6473"/>
            <!-- v3.9.0: sidebar icon colour per section (darker shades for light surfaces) -->
            <SolidColorBrush x:Key="NavLibraryIconBrush"  Color="#2563EB"/>
            <SolidColorBrush x:Key="NavDiscoverIconBrush" Color="#0E8566"/>
            <SolidColorBrush x:Key="NavBrowseIconBrush"   Color="#A86A00"/>
            <SolidColorBrush x:Key="NavToolsIconBrush"    Color="#5F6473"/>
            <SolidColorBrush x:Key="InputBgBrush"    Color="#FFFFFF"/>
            <SolidColorBrush x:Key="InputBorderBrush" Color="#BDBDD2"/>
            <SolidColorBrush x:Key="ChipBrush"       Color="#E2EAF5"/>
            <SolidColorBrush x:Key="HeroBgBrush"     Color="#991D3A5C"/>
            <LinearGradientBrush x:Key="HeroFadeBrush" StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.00" Color="#00F6F6FA"/>
                            <GradientStop Offset="0.48" Color="#00F6F6FA"/>
                            <GradientStop Offset="0.60" Color="#08F6F6FA"/>
                            <GradientStop Offset="0.70" Color="#22F6F6FA"/>
                            <GradientStop Offset="0.79" Color="#55F6F6FA"/>
                            <GradientStop Offset="0.87" Color="#99F6F6FA"/>
                            <GradientStop Offset="0.94" Color="#DDF6F6FA"/>
                            <GradientStop Offset="1.00" Color="#FFF6F6FA"/>
                        </LinearGradientBrush>
            <SolidColorBrush x:Key="OverlayBrush"    Color="#CC1D3A5C"/>
            <SolidColorBrush x:Key="PlaceholderBgBrush" Color="#EEF4FF"/>
            <Color x:Key="PlaceholderTopColor">#EFF5FF</Color>
            <Color x:Key="PlaceholderBottomColor">#D7E5F7</Color>
            <SolidColorBrush x:Key="ToastBgBrush"    Color="#E8F1FF"/>
            <SolidColorBrush x:Key="SubtleBgBrush"   Color="#E8F0FF"/>
            <!-- Sidebar section header (orange-tinted) -->
            <SolidColorBrush x:Key="SectionHeaderBgBrush"      Color="#FFF4E6"/>
            <SolidColorBrush x:Key="SectionHeaderBorderBrush"  Color="#F59E0B"/>
            <SolidColorBrush x:Key="SectionHeaderHoverBgBrush" Color="#FFE8CC"/>
            <SolidColorBrush x:Key="SectionHeaderTextBrush"    Color="#9A6300"/>
            <!-- Nav item active / hover states (Light). v2.5.2 — same idea
                 as Dark: tint hover with a soft purple so the sidebar feels
                 alive instead of inert. -->
            <SolidColorBrush x:Key="NavHoverBgBrush"            Color="#333B82F6"/>
            <SolidColorBrush x:Key="NavPressedBgBrush"          Color="#553B82F6"/>
            <SolidColorBrush x:Key="NavActiveBgBrush"           Color="#443B82F6"/>
            <SolidColorBrush x:Key="NavActiveHoverBgBrush"      Color="#553B82F6"/>
            <SolidColorBrush x:Key="NavHoverBorderBrush"        Color="#883B82F6"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Default">
            <!-- Follows the system theme — reuse Dark values as fallback -->
            <!-- Content + cards are OPAQUE so the scrolling poster grid never
                 composites over the live Mica backdrop (fast). Only the
                 sidebar (small, fixed area) stays translucent for the Mica
                 accent. -->
            <SolidColorBrush x:Key="BgBrush"         Color="#0A0A0C"/>
            <SolidColorBrush x:Key="SidebarBrush"    Color="#990F0F18"/>
            <SolidColorBrush x:Key="SidebarGlassBrush" Color="#CC0F0F18"/>
            <SolidColorBrush x:Key="CardBrush"       Color="#14141F"/>
            <SolidColorBrush x:Key="CardHoverBrush"  Color="#1E1E2E"/>
            <SolidColorBrush x:Key="BorderBrush"     Color="#2A2A3A"/>
            <SolidColorBrush x:Key="TextBrush"       Color="#E8E8F0"/>
            <SolidColorBrush x:Key="MutedBrush"      Color="#6B7280"/>
            <!-- v3.9.0: sidebar icon colour per section, as in Aryan -->
            <SolidColorBrush x:Key="NavLibraryIconBrush"  Color="#3B82F6"/>
            <SolidColorBrush x:Key="NavDiscoverIconBrush" Color="#4CC9A4"/>
            <SolidColorBrush x:Key="NavBrowseIconBrush"   Color="#F5B83D"/>
            <SolidColorBrush x:Key="NavToolsIconBrush"    Color="#9CA3AF"/>
            <SolidColorBrush x:Key="InputBgBrush"    Color="#14141F"/>
            <SolidColorBrush x:Key="InputBorderBrush" Color="#2A2A3A"/>
            <SolidColorBrush x:Key="ChipBrush"       Color="#1E1E2E"/>
            <SolidColorBrush x:Key="HeroBgBrush"     Color="#990A0A1C"/>
            <LinearGradientBrush x:Key="HeroFadeBrush" StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.00" Color="#000A0A0C"/>
                            <GradientStop Offset="0.48" Color="#000A0A0C"/>
                            <GradientStop Offset="0.62" Color="#080A0A0C"/>
                            <GradientStop Offset="0.73" Color="#220A0A0C"/>
                            <GradientStop Offset="0.83" Color="#660A0A0C"/>
                            <GradientStop Offset="0.92" Color="#CC0A0A0C"/>
                            <GradientStop Offset="1.00" Color="#FF0A0A0C"/>
                        </LinearGradientBrush>
            <SolidColorBrush x:Key="OverlayBrush"    Color="#CC0A0A1C"/>
            <SolidColorBrush x:Key="PlaceholderBgBrush" Color="#172033"/>
            <Color x:Key="PlaceholderTopColor">#1A2233</Color>
            <Color x:Key="PlaceholderBottomColor">#0B1220</Color>
            <SolidColorBrush x:Key="ToastBgBrush"    Color="#1E1E3A"/>
            <SolidColorBrush x:Key="SubtleBgBrush"   Color="#0A1A2A"/>
            <!-- Sidebar section header (orange-tinted) -->
            <SolidColorBrush x:Key="SectionHeaderBgBrush"      Color="#3A2410"/>
            <SolidColorBrush x:Key="SectionHeaderBorderBrush"  Color="#B45309"/>
            <SolidColorBrush x:Key="SectionHeaderHoverBgBrush" Color="#4F2F15"/>
            <SolidColorBrush x:Key="SectionHeaderTextBrush"    Color="#FBBF77"/>
            <!-- Nav item active / hover states (Default = Dark fallback). -->
            <SolidColorBrush x:Key="NavHoverBgBrush"            Color="#263B82F6"/>
            <SolidColorBrush x:Key="NavPressedBgBrush"          Color="#3D3B82F6"/>
            <SolidColorBrush x:Key="NavActiveBgBrush"           Color="#553B82F6"/>
            <SolidColorBrush x:Key="NavActiveHoverBgBrush"      Color="#663B82F6"/>
            <SolidColorBrush x:Key="NavHoverBorderBrush"        Color="#553B82F6"/>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- ═══ BRAND COLOURS (fixed — same in all themes) ════════════════════ -->
    <SolidColorBrush x:Key="BrandPurpleBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="BrandGoldBrush"   Color="#F59E0B"/>
    <SolidColorBrush x:Key="AccentRedBrush"   Color="#EF4444"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="#22C55E"/>

</ResourceDictionary>
